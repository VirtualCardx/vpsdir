{
  "name": "vpsdir",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/prebuild.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && node scripts/prebuild.mjs && astro build",
    "preview": "astro preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply vpsdir-db --remote",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260504.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.87.0"
  }
}
