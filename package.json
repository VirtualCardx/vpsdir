{
  "name": "vpsdir",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && astro build",
    "preview": "astro preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply vpsdir-db --local",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "astro": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "sanitize-html": "^2.17.3",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260504.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.87.0"
  }
}
