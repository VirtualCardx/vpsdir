---
import { locales, type Locale } from '../i18n/config';
import { getAlternateUrl } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels: Record<string, string> = { zh: '中文', en: 'EN' };
---

<div class="flex items-center gap-1">
  {locales.map((locale) => (
    <a
      href={getAlternateUrl(Astro.url, locale)}
      class:list={[
        'text-sm px-2 py-1 rounded transition-colors',
        locale === lang ? 'bg-gray-900 text-white' : 'text-gray-600 hover:bg-gray-100',
      ]}
    >
      {labels[locale]}
    </a>
  ))}
</div>
