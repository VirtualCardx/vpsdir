---
import { locales, type Locale } from '../i18n/config';
import { getAlternateUrl } from '../i18n/utils';

interface Props {
  lang: Locale;
  alternates?: { lang: string; href: string }[];
}

const { lang, alternates } = Astro.props;
const labels: Record<string, string> = { zh: '中文', en: 'EN' };
const alternateMap = new Map(alternates?.map((item) => [item.lang, item.href]) || []);
---

<div class="flex items-center gap-1">
  {locales.map((locale) => (
    <a
      href={alternateMap.get(locale) || getAlternateUrl(Astro.url, locale)}
      class:list={[
        'nav-pill text-sm px-2 py-1 rounded transition-colors',
        locale === lang && 'is-current',
      ]}
    >
      {labels[locale]}
    </a>
  ))}
</div>
