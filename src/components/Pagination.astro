---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  query?: Record<string, string | undefined>;
  lang: 'zh' | 'en';
}

const { currentPage, totalPages, basePath, query = {}, lang } = Astro.props;

const pageHref = (page: number) => {
  const params = new URLSearchParams();
  for (const [key, value] of Object.entries(query)) {
    if (value) params.set(key, value);
  }
  if (page > 1) params.set('page', String(page));
  const search = params.toString();
  return `${basePath}${search ? `?${search}` : ''}`;
};

const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1).filter((page) => (
  page === 1 || page === totalPages || Math.abs(page - currentPage) <= 2
));
---

{totalPages > 1 && (
  <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label={lang === 'zh' ? '分页导航' : 'Pagination'}>
    {currentPage > 1 ? (
      <a class="pagination-link" href={pageHref(currentPage - 1)} rel="prev">
        {lang === 'zh' ? '上一页' : 'Previous'}
      </a>
    ) : (
      <span class="pagination-link is-disabled" aria-disabled="true">{lang === 'zh' ? '上一页' : 'Previous'}</span>
    )}

    {pageNumbers.map((page, index) => (
      <Fragment>
        {index > 0 && page - pageNumbers[index - 1] > 1 && <span class="px-1 text-gray-400" aria-hidden="true">…</span>}
        <a
          class:list={['pagination-link', { 'is-current': page === currentPage }]}
          href={pageHref(page)}
          aria-current={page === currentPage ? 'page' : undefined}
        >
          {page}
        </a>
      </Fragment>
    ))}

    {currentPage < totalPages ? (
      <a class="pagination-link" href={pageHref(currentPage + 1)} rel="next">
        {lang === 'zh' ? '下一页' : 'Next'}
      </a>
    ) : (
      <span class="pagination-link is-disabled" aria-disabled="true">{lang === 'zh' ? '下一页' : 'Next'}</span>
    )}
  </nav>
)}

<style>
  .pagination-link {
    display: inline-flex;
    min-width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--theme-border);
    border-radius: 0.625rem;
    background: #fff;
    color: #374151;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .pagination-link:hover:not(.is-disabled),
  .pagination-link.is-current {
    border-color: var(--theme-primary);
    background: var(--theme-primary);
    color: #fff;
  }

  .pagination-link.is-disabled {
    cursor: not-allowed;
    background: #f9fafb;
    color: #9ca3af;
  }
</style>
