---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';
import { getLogoUrl } from '../lib/r2';
import { richTextToPlainText } from '../lib/rich-text';
import { parseStoredTags } from '../lib/validation';

interface Props {
  provider: {
    slug_zh: string;
    slug_en: string;
    category: string;
    rating: number | null;
    logo_key: string | null;
    tags: string | null;
    updated_at: string;
  };
  content: {
    name: string;
    desc: string | null;
  };
  lang: Locale;
}

const { provider, content, lang } = Astro.props;
const slug = lang === 'zh' ? provider.slug_zh : provider.slug_en;
const logoUrl = getLogoUrl(provider.logo_key, provider.updated_at);
const descText = richTextToPlainText(content.desc);

// Parse tags JSON (supports both old flat array and new bilingual format)
const rawTags = parseStoredTags(provider.tags);
const tags = rawTags.map(tag => {
  if (typeof tag === 'string') return tag;
  return tag[lang] || tag.zh || tag.en || '';
});
---

<a
  href={`/${lang}/provider/${slug}/`}
  class="provider-card block"
>
  <div class="flex items-start gap-4">
    <img
      src={logoUrl}
      alt={content.name}
      class="provider-logo w-12 h-12 rounded-lg object-contain flex-shrink-0"
      loading="lazy"
      width="48"
      height="48"
    />
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-gray-900 truncate tracking-tight">{content.name}</h3>
      <span class="inline-block text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded mt-1">
        {t(lang, `categories.${provider.category}`)}
      </span>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2">
          {tags.map((tag) => (
            <span class="inline-block text-xs px-2 py-0.5 tag-chip rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
      {descText && <p class="text-sm text-gray-500 mt-2 line-clamp-2">{descText}</p>}
    </div>
  </div>
  <div class="provider-card-footer">
    <span class="provider-rating">
      {provider.rating != null && provider.rating > 0 ? (
        <><span aria-hidden="true">★</span> {provider.rating.toFixed(1)}</>
      ) : (lang === 'zh' ? '服务商资料' : 'Provider profile')}
    </span>
    <span class="provider-card-action">{lang === 'zh' ? '查看详情' : 'View details'} <span aria-hidden="true">→</span></span>
  </div>
</a>
