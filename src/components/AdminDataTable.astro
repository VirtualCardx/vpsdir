---
interface Props {
  class?: string;
  tableClass?: string;
  headClass?: string;
  bodyClass?: string;
}

const {
  class: className = '',
  tableClass = '',
  headClass = '',
  bodyClass = '',
} = Astro.props;

const hasHead = Astro.slots.has('head');
---

<div class:list={['admin-table-card', className]}>
  <div class="admin-table-wrap">
    <table class:list={['admin-table', tableClass]}>
      {hasHead && (
        <thead class={headClass}>
          <slot name="head" />
        </thead>
      )}
      <tbody class={bodyClass}>
        <slot />
      </tbody>
    </table>
  </div>
</div>
