---
interface Props {
  title: string;
  description?: string;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown>;
  xDefault?: string;
}

const { title, description, alternates, jsonLd, xDefault } = Astro.props;
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const siteName = 'VPSDEX';
const ogImage = `${siteUrl}/favicon.svg`;
---

<title>{title}</title>
<meta name="description" content={description || ''} />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || ''} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={alternates?.[0]?.lang === 'en' ? 'en_US' : 'zh_CN'} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || ''} />
<meta name="twitter:image" content={ogImage} />

<!-- Hreflang -->
{alternates?.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault || `${siteUrl}/zh/`} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
