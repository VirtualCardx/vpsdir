---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<header class="site-nav border-b sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4">
    <nav class="flex items-center justify-between">
      <a href={`/${lang}/`} class="nav-brand text-lg font-bold transition-colors">
        {t(lang, 'site.brand')}
      </a>
      <div class="flex items-center gap-6">
        <a href={`/${lang}/`} class="nav-link text-sm transition-colors">
          {t(lang, 'nav.home')}
        </a>
        <a href={`/${lang}/activities/`} class="nav-link text-sm transition-colors">
          {t(lang, 'nav.activities')}
        </a>
        <LanguageSwitcher lang={lang} />
      </div>
    </nav>
  </div>
</header>
