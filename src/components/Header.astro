---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { primaryProviderCategories } from '../lib/provider-categories';

interface Props {
  lang: Locale;
  alternates?: { lang: string; href: string }[];
}

const { lang, alternates } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-nav border-b sticky top-0 z-50">
  <div class="site-shell mx-auto px-5 sm:px-6 py-3">
    <nav class="flex items-center justify-between gap-4">
      <a href={`/${lang}/`} class="nav-brand shrink-0 flex items-center gap-2.5 text-base font-bold transition-colors" aria-label={t(lang, 'site.brand')}>
        <span class="brand-mark" aria-hidden="true">V</span>
        <span>{t(lang, 'site.brand')}</span>
      </a>
      <div class="site-nav-links flex min-w-0 items-center gap-1 overflow-x-auto">
        <a href={`/${lang}/`} aria-current={currentPath === `/${lang}/` ? 'page' : undefined} class:list={["nav-link shrink-0 whitespace-nowrap text-sm transition-colors", { "is-active": currentPath === `/${lang}/` }] }>
          {t(lang, 'nav.home')}
        </a>
        {primaryProviderCategories.map((category) => {
          const href = `/${lang}/category/${category}/`;
          return (
            <a
              href={href}
              aria-current={currentPath === href ? 'page' : undefined}
              class:list={["nav-link shrink-0 whitespace-nowrap text-sm transition-colors", { "is-active": currentPath === href }]}
            >
              {t(lang, `categories.${category}`)}
            </a>
          );
        })}
        <a href={`/${lang}/activities/`} aria-current={currentPath.startsWith(`/${lang}/activit`) ? 'page' : undefined} class:list={["nav-link shrink-0 whitespace-nowrap text-sm transition-colors", { "is-active": currentPath.startsWith(`/${lang}/activit`) }]}>
          {t(lang, 'nav.activities')}
        </a>
        <LanguageSwitcher lang={lang} alternates={alternates} />
      </div>
    </nav>
  </div>
</header>
