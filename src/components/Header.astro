---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Locale;
  alternates?: { lang: string; href: string }[];
}

const { lang, alternates } = Astro.props;
const currentYear = new Date().getFullYear();
---

<header class="site-nav border-b sticky top-0 z-50">
  <div class="site-shell mx-auto px-5 sm:px-6 py-3.5">
    <nav class="flex items-center justify-between">
      <a href={`/${lang}/`} class="nav-brand text-base font-bold transition-colors">
        {t(lang, 'site.brand')}
      </a>
      <div class="flex items-center gap-4 sm:gap-6">
        <a href={`/${lang}/`} class="nav-link text-sm transition-colors">
          {t(lang, 'nav.home')}
        </a>
        <a href={`/${lang}/activities/`} class="nav-link text-sm transition-colors">
          {t(lang, 'nav.activities')}
        </a>
        <LanguageSwitcher lang={lang} alternates={alternates} />
      </div>
    </nav>
  </div>
</header>
