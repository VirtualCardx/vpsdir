---
interface Props {
  title?: string;
  description?: string;
  class?: string;
  as?: 'div' | 'section';
}

const {
  title,
  description,
  class: className = '',
  as = 'section',
} = Astro.props;

const Tag = as;
const hasHeader = Boolean(title || description || Astro.slots.has('actions'));
---

<Tag class:list={['admin-card', className]}>
  {hasHeader && (
    <div class:list={['admin-section-header', Astro.slots.has('actions') && 'flex flex-col gap-3 md:flex-row md:items-start md:justify-between']}>
      <div>
        {title && <h2 class="admin-section-title">{title}</h2>}
        {description && <p class="admin-section-desc">{description}</p>}
      </div>

      {Astro.slots.has('actions') && (
        <div class="flex flex-wrap items-center gap-3 md:justify-end">
          <slot name="actions" />
        </div>
      )}
    </div>
  )}

  <slot />
</Tag>
