---
interface Props {
  metaText?: string;
  refreshAction?: string;
  refreshLabel?: string;
  logoutAction?: string;
  logoutLabel: string;
}

const {
  metaText,
  refreshAction,
  refreshLabel = '刷新',
  logoutAction = '/api/auth/logout',
  logoutLabel,
} = Astro.props;
---

{metaText && <span class="admin-meta-text">{metaText}</span>}

{refreshAction && (
  <form method="POST" action={refreshAction} class="inline">
    <button
      type="submit"
      class="admin-btn admin-btn-sm admin-btn-accent"
    >
      {refreshLabel}
    </button>
  </form>
)}

<form method="POST" action={logoutAction} class="inline">
  <button
    type="submit"
    class="admin-btn-link"
  >
    {logoutLabel}
  </button>
</form>
