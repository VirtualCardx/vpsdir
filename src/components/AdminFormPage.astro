---
import AdminSectionCard from './AdminSectionCard.astro';

interface Props {
  title?: string;
  description?: string;
  class?: string;
  formClass?: string;
  method?: 'GET' | 'POST';
  action?: string;
  enctype?: string;
  id?: string;
  wrapMain?: boolean;
}

const {
  title,
  description,
  class: className = '',
  formClass = 'space-y-4',
  method = 'POST',
  action,
  enctype,
  id,
  wrapMain = true,
} = Astro.props;
---

{wrapMain ? (
  <main class="container mx-auto px-4 py-6">
    <slot name="before" />

    <AdminSectionCard
      title={title}
      description={description}
      class={className}
    >
      {Astro.slots.has('actions') && (
        <Fragment slot="actions">
          <slot name="actions" />
        </Fragment>
      )}

      <form
        method={method}
        action={action}
        enctype={enctype}
        id={id}
        class={formClass}
      >
        <slot />
      </form>
    </AdminSectionCard>
  </main>
) : (
  <>
    <slot name="before" />

    <AdminSectionCard
      title={title}
      description={description}
      class={className}
    >
      {Astro.slots.has('actions') && (
        <Fragment slot="actions">
          <slot name="actions" />
        </Fragment>
      )}

      <form
        method={method}
        action={action}
        enctype={enctype}
        id={id}
        class={formClass}
      >
        <slot />
      </form>
    </AdminSectionCard>
  </>
)}
