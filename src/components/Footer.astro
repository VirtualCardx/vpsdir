---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer border-t py-12 mt-20">
  <div class="site-shell mx-auto px-5 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <span class="brand-mark" aria-hidden="true">V</span>
          <h3 class="font-semibold">{t(lang, 'site.brand')}</h3>
        </div>
        <p class="nav-subtitle text-sm">{t(lang, 'site.description')}</p>
      </div>
      <div>
        <h3 class="font-semibold mb-4">{lang === 'zh' ? '快速链接' : 'Quick Links'}</h3>
        <ul class="space-y-2">
          <li>
            <a href={`/${lang}/`} class="nav-link text-sm transition-colors">
              {t(lang, 'nav.home')}
            </a>
          </li>
          <li>
            <a href={`/${lang}/activities/`} class="nav-link text-sm transition-colors">
              {t(lang, 'nav.activities')}
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4">{lang === 'zh' ? '关于' : 'About'}</h3>
        <ul class="space-y-2">
          <li><a href={`/${lang}/about/`} class="nav-link text-sm">{lang === 'zh' ? '关于我们' : 'About us'}</a></li>
          <li><a href={`/${lang}/methodology/`} class="nav-link text-sm">{lang === 'zh' ? '评测方法' : 'Review methodology'}</a></li>
          <li><a href={`/${lang}/disclosure/`} class="nav-link text-sm">{lang === 'zh' ? '商业披露' : 'Commercial disclosure'}</a></li>
          <li><a href={`/${lang}/contact/`} class="nav-link text-sm">{lang === 'zh' ? '联系与纠错' : 'Contact & corrections'}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4">{lang === 'zh' ? '政策' : 'Policies'}</h3>
        <ul class="space-y-2">
          <li><a href={`/${lang}/privacy/`} class="nav-link text-sm">{lang === 'zh' ? '隐私政策' : 'Privacy policy'}</a></li>
          <li><a href={`/${lang}/terms/`} class="nav-link text-sm">{lang === 'zh' ? '使用条款' : 'Terms of use'}</a></li>
        </ul>
      </div>
    </div>
    <div class="pt-7 border-t footer-divider text-center">
      <p class="nav-subtitle text-sm">
        &copy; {currentYear} {t(lang, 'site.brand')}. {lang === 'zh' ? '保留所有权利。' : 'All rights reserved.'}
      </p>
    </div>
  </div>
</footer>
