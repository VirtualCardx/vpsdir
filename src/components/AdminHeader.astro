---
type NavItem = {
  href: string;
  label: string;
  current?: boolean;
};

interface Props {
  title: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
  navItems?: NavItem[];
}

const {
  title,
  subtitle,
  backHref,
  backLabel = '返回',
  navItems = [],
} = Astro.props;

const hasActions = Astro.slots.has('actions');
---

<header class="bg-white border-b border-gray-200">
  <div class="container mx-auto px-4 py-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-3">
        {backHref && (
          <a
            href={backHref}
            class="inline-flex items-center rounded-md border border-gray-200 px-3 py-1.5 text-sm text-gray-600 hover:border-gray-300 hover:text-gray-900 transition-colors"
          >
            &larr; {backLabel}
          </a>
        )}
        <div class="min-w-0">
          <h1 class="text-lg font-bold text-gray-900">{title}</h1>
          {subtitle && <p class="mt-1 text-sm text-gray-500">{subtitle}</p>}
        </div>
      </div>

      {navItems.length > 0 && (
        <nav class="mt-3 flex flex-wrap items-center gap-2" aria-label="后台导航">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center rounded-full px-3 py-1.5 text-sm transition-colors',
                item.current
                  ? 'bg-gray-900 text-white'
                  : 'bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-gray-900',
              ]}
              aria-current={item.current ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    {hasActions && (
      <div class="flex flex-wrap items-center gap-3 md:justify-end">
        <slot name="actions" />
      </div>
    )}
  </div>
</header>
