---
import '../../../styles/global.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { isValidLocale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { activities, activitiesContent, activityCategories } from '../../../db/schema';
import { eq, and, desc, sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { richTextToPlainText, sanitizeRichText } from '../../../lib/rich-text';

const lang = Astro.params.lang as string;
const slug = Astro.params.slug;

if (!isValidLocale(lang)) {
  return Astro.redirect('/zh/');
}

const db = getDb(env.DB);

// Get activity
const activityData = await db
  .select()
  .from(activities)
  .where(and(eq(activities.slug, slug), eq(activities.is_active, true)))
  .limit(1);

const activityBasic = activityData[0];

if (!activityBasic) {
  return Astro.redirect('/zh/activities/');
}

// Get content and category info
const contentData = await db
  .select()
  .from(activitiesContent)
  .where(and(eq(activitiesContent.activity_id, activityBasic.id), eq(activitiesContent.lang, lang)))
  .limit(1);

const categoryData = await db
  .select()
  .from(activityCategories)
  .where(eq(activityCategories.id, activityBasic.category_id))
  .limit(1);

const activity = {
  id: activityBasic.id,
  slug: activityBasic.slug,
  categoryId: activityBasic.category_id,
  publishedAt: activityBasic.published_at,
  isFeatured: activityBasic.is_featured,
  viewCount: activityBasic.view_count,
  title: contentData[0]?.title || '',
  description: contentData[0]?.description || '',
  content: contentData[0]?.content || '',
  metaTitle: contentData[0]?.meta_title || '',
  metaDesc: contentData[0]?.meta_desc || '',
  categorySlug: categoryData[0]?.slug || '',
  categoryIcon: categoryData[0]?.icon || '',
};

// Increment view count
await db.update(activities)
  .set({ view_count: activityBasic.view_count + 1 })
  .where(eq(activities.id, activityBasic.id));

// Get related activities
const relatedActivitiesData = await db
  .select()
  .from(activities)
  .where(and(
    eq(activities.is_active, true),
    eq(activities.category_id, activity.categoryId),
    sql`${activities.id} != ${activityBasic.id}`
  ))
  .orderBy(desc(activities.published_at))
  .limit(4);

const relatedActivities = await Promise.all(
  relatedActivitiesData.map(async (relatedActivity) => {
    const relatedContent = await db
      .select()
      .from(activitiesContent)
      .where(and(eq(activitiesContent.activity_id, relatedActivity.id), eq(activitiesContent.lang, lang)))
      .limit(1)
      .then(rows => rows[0]);

    const relatedCategory = await db
      .select()
      .from(activityCategories)
      .where(eq(activityCategories.id, relatedActivity.category_id))
      .limit(1)
      .then(rows => rows[0]);

    return {
      slug: relatedActivity.slug,
      title: relatedContent?.title || '',
      publishedAt: relatedActivity.published_at,
      categorySlug: relatedCategory?.slug || '',
    };
  })
);

const siteName = t(lang, 'site.title');
const pageTitle = activity.metaTitle || activity.title;
const pageDesc = activity.metaDesc || activity.description || richTextToPlainText(activity.content).slice(0, 160);
const pageUrl = `${Astro.site}/${lang}/activity/${slug}/`;
const categoryLabel = activity.categorySlug;

// Get content as plain text for SEO
const contentText = richTextToPlainText(activity.content);
const wordCount = contentText.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200); // Assume 200 words per minute
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} - {siteName}</title>
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="article:published_time" content={activity.publishedAt} />
    <meta property="article:section" content={activity.categorySlug} />
    {activity.isFeatured && <meta property="article:section" content="featured" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <!-- Schema.org structured data for Article -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": activity.title,
      "description": pageDesc,
      "url": pageUrl,
      "datePublished": activity.publishedAt,
      "dateModified": activity.publishedAt,
      "inLanguage": lang,
      "wordCount": wordCount,
      "genre": [activity.categorySlug, activity.isFeatured ? "featured" : ""].filter(Boolean),
      "articleSection": activity.categorySlug,
      "author": {
        "@type": "Organization",
        "name": siteName
      },
      "publisher": {
        "@type": "Organization",
        "name": siteName,
        "logo": {
          "@type": "ImageObject",
          "url": `${Astro.site}/logo.png`
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      }
    })} />

    <!-- Breadcrumb Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": siteName,
          "item": `${Astro.site}/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": lang === 'zh' ? "最新活动" : "Latest Activities",
          "item": `${Astro.site}/${lang}/activities/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": activity.title,
          "item": pageUrl
        }
      ]
    })} />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 flex flex-col">
    <Header lang={lang} />

    <main class="flex-1 container mx-auto px-4 py-8 max-w-4xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href={`/${lang}/`} class="hover:text-gray-700">{siteName}</a>
        <span>/</span>
        <a href={`/${lang}/activities/`} class="hover:text-gray-700">
          {lang === 'zh' ? '最新活动' : 'Latest Activities'}
        </a>
        <span>/</span>
        <span class="text-gray-900">{activity.title}</span>
      </nav>

      <!-- Article Header -->
      <article class="bg-white rounded-lg border border-gray-200 p-8 mb-8">
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100">
              {categoryLabel}
            </span>
            {activity.isFeatured && (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                ⭐ {lang === 'zh' ? '推荐' : 'Featured'}
              </span>
            )}
          </div>

          <h1 class="text-4xl font-bold mb-4">{activity.title}</h1>

          {activity.description && (
            <p class="text-xl text-gray-600 mb-6">{activity.description}</p>
          )}

          <div class="flex items-center gap-4 text-sm text-gray-500">
            <time datetime={activity.publishedAt}>
              {new Date(activity.publishedAt).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span>•</span>
            <span>{readingTime} {lang === 'zh' ? '分钟阅读' : 'min read'}</span>
            <span>•</span>
            <span>{activity.viewCount + 1} {lang === 'zh' ? '次浏览' : 'views'}</span>
          </div>
        </header>

        <!-- Article Content -->
        <div class="rich-content prose prose-lg max-w-none">
          <div set:html={sanitizeRichText(activity.content) || '<p>' + richTextToPlainText(activity.content) + '</p>'} />
        </div>
      </article>

      <!-- Related Activities -->
      {relatedActivities.length > 0 && (
        <section class="bg-white rounded-lg border border-gray-200 p-6">
          <h2 class="text-2xl font-bold mb-6">
            {lang === 'zh' ? '相关活动' : 'Related Activities'}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {relatedActivities.map((related) => (
              <a href={`/${lang}/activity/${related.slug}/`} class="block p-4 rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all">
                <div class="text-xs text-gray-500 mb-2">
                  {related.categorySlug} • {new Date(related.publishedAt).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US')}
                </div>
                <h3 class="font-semibold mb-2 line-clamp-2">{related.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  .prose {
    --tw-prose-body: rgb(55 65 81);
    --tw-prose-headings: rgb(17 24 39);
    --tw-prose-links: rgb(37 99 235);
    --tw-prose-bold: rgb(17 24 39);
    --tw-prose-code: rgb(219 39 119);
  }

  .prose h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .prose h3 {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.625rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 4px solid rgb(209 213 219);
    padding-left: 1rem;
    font-style: italic;
    color: rgb(75 85 99);
    margin-bottom: 1.25rem;
  }

  .prose pre {
    background-color: rgb(243 244 246);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .prose code {
    background-color: rgb(243 244 246);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .prose hr {
    margin: 2rem 0;
    border-color: rgb(209 213 219);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>