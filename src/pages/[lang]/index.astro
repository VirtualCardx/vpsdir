---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import { isValidLocale, defaultLocale, locales, type Locale } from '../../i18n/config';
import { t } from '../../i18n/utils';
import { getDb } from '../../lib/db';
import { getCached, setCache } from '../../lib/cache';
import { providers, providersContent } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { richTextToPlainText } from '../../lib/rich-text';

const lang = Astro.params.lang as string;
if (!isValidLocale(lang)) {
  return Astro.redirect(`/${defaultLocale}/`);
}

const db = getDb(env.DB);

// Try KV cache first
const cacheKey = `home:${lang}`;
type ProviderRow = {
  providers: typeof providers.$inferSelect;
  providers_content: typeof providersContent.$inferSelect | null;
};
let data = await getCached<ProviderRow[]>(env.VPSDIR_KV, cacheKey);

if (!data) {
  const rows = await db
    .select()
    .from(providers)
    .leftJoin(
      providersContent,
      and(eq(providers.id, providersContent.provider_id), eq(providersContent.lang, lang)),
    )
    .where(eq(providers.is_active, true))
    .orderBy(providers.category, providers.id);

  data = rows;
  await setCache(env.VPSDIR_KV, cacheKey, data);
}

// Group by category
const categories = new Map<string, ProviderRow[]>();
for (const row of data) {
  const cat = row.providers.category;
  if (!categories.has(cat)) categories.set(cat, []);
  categories.get(cat)!.push(row);
}

const siteUrl = Astro.url.origin;
const alternates = locales.map((l) => ({ lang: l, href: `${siteUrl}/${l}/` }));

// Prepare data for client-side search
const providerSearchData = Array.from(categories.entries()).flatMap(([cat, items]) =>
  items.map(item => ({
    ...item,
    category: cat,
    providers_content: item.providers_content
      ? {
          ...item.providers_content,
          desc: richTextToPlainText(item.providers_content.desc),
        }
      : null,
  })));

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t(lang as Locale, 'site.title'),
  description: t(lang as Locale, 'site.description'),
  url: `${Astro.url.origin}/${lang}/`,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.url.origin}/${lang}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title={t(lang, 'site.title')}
  description={t(lang, 'site.description')}
  lang={lang as Locale}
  alternates={alternates}
  jsonLd={homeJsonLd}
>
  <h1 class="text-3xl font-bold mb-6">{t(lang, 'site.description')}</h1>

  <!-- Search Bar -->
  <div class="mb-6">
    <div class="flex gap-2">
      <div class="relative flex-1">
        <input
          type="text"
          id="search-input"
          placeholder="搜索服务商名称或标签..."
          class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
        />
        <svg class="absolute left-4 top-3.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <button
        id="search-button"
        class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium flex items-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        搜索
      </button>
      <button
        id="clear-button"
        class="px-4 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors text-sm font-medium"
      >
        清除
      </button>
    </div>
    <div id="search-tags" class="mt-3 flex flex-wrap gap-2">
      <!-- Active search tags will appear here -->
    </div>
  </div>

  <div id="provider-container">
    {categories.size === 0 && (
      <p class="text-gray-500 text-center py-12">{t(lang, 'admin.noProviders')}</p>
    )}

  {Array.from(categories.entries()).map(([category, items]) => (
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">
        {t(lang, `categories.${category}`)}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.map((row) => (
          <ProviderCard
            provider={row.providers}
            content={
              row.providers_content || { name: row.providers.slug_en, desc: null }
            }
            lang={lang as Locale}
          />
        ))}
      </div>
    </section>
  ))}
  </div>

  <script define:vars={{ data: JSON.stringify(providerSearchData), lang }}>
    const allProviders = JSON.parse(data);
    const searchInput = document.getElementById('search-input');
    const searchButton = document.getElementById('search-button');
    const clearButton = document.getElementById('clear-button');
    const searchTags = document.getElementById('search-tags');
    const providerContainer = document.getElementById('provider-container');

    // Escape HTML to prevent XSS
    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    let currentSearch = '';
    let currentTagFilter = '';

    // Helper: parse tags JSON, supports old flat array and new bilingual format
    function parseTags(raw) {
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return parsed.map(tag => {
        if (typeof tag === 'string') return tag;
        return tag[lang] || tag.zh || tag.en || '';
      });
    }

    // Helper: get all tag texts for search matching (both languages)
    function allTagTexts(raw) {
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return parsed.flatMap(tag => {
        if (typeof tag === 'string') return [tag];
        return [tag.zh, tag.en].filter(Boolean);
      });
    }

    // Search button click
    searchButton.addEventListener('click', function(e) {
      e.preventDefault();
      currentSearch = searchInput.value.toLowerCase().trim();
      filterProviders();
    });

    // Enter key in search input
    searchInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        searchButton.click();
      }
    });

    // Clear button click
    clearButton.addEventListener('click', function(e) {
      e.preventDefault();
      searchInput.value = '';
      currentSearch = '';
      currentTagFilter = '';

      // Reset all tag buttons
      const tagButtons = searchTags.querySelectorAll('[data-tag]');
      tagButtons.forEach(button => {
        button.classList.remove('bg-blue-500', 'text-white');
        button.classList.add('bg-blue-50', 'text-blue-700');
      });

      filterProviders();
    });

    function filterProviders() {
      if (!currentSearch && !currentTagFilter) {
        renderProviders(allProviders);
        return;
      }

      const filtered = allProviders.filter(provider => {
        const content = provider.providers_content;
        const name = content?.name?.toLowerCase() || '';
        const desc = content?.desc?.toLowerCase() || '';
        const tagsForSearch = allTagTexts(provider.providers.tags);
        const tagsForDisplay = parseTags(provider.providers.tags);

        const matchesSearch = name.includes(currentSearch) ||
                            desc.includes(currentSearch) ||
                            tagsForSearch.some(tag => tag.toLowerCase().includes(currentSearch));

        const matchesTag = !currentTagFilter || tagsForDisplay.includes(currentTagFilter);

        return matchesSearch && matchesTag;
      });

      renderProviders(filtered);
    }

    function renderProviders(providers) {
      // Group by category
      const categories = new Map();
      for (const provider of providers) {
        const cat = provider.category;
        if (!categories.has(cat)) categories.set(cat, []);
        categories.get(cat).push(provider);
      }

      if (categories.size === 0) {
        providerContainer.innerHTML = '<p class="text-gray-500 text-center py-12">没有找到匹配的服务商</p>';
        return;
      }

      providerContainer.innerHTML = Array.from(categories.entries()).map(([category, items]) => `
        <section class="mb-10">
          <h2 class="text-xl font-semibold mb-4 text-gray-800">${escapeHtml(category)}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            ${items.map(row => {
              const content = row.providers_content || { name: row.providers.slug_en, desc: null };
              const tags = parseTags(row.providers.tags);
              const logoUrl = row.providers.logo_key ? `/api/logo/${escapeHtml(row.providers.logo_key)}` : 'https://via.placeholder.com/48';
              const slug = lang === 'zh' ? row.providers.slug_zh : row.providers.slug_en;

              return `
                <a href="/${lang}/provider/${escapeHtml(slug)}" class="block border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow bg-white">
                  <div class="flex items-start gap-4">
                    <img src="${escapeHtml(logoUrl)}" alt="${escapeHtml(content.name)}" class="w-12 h-12 rounded object-contain flex-shrink-0 bg-gray-50" loading="lazy" width="48" height="48" />
                    <div class="flex-1 min-w-0">
                      <h3 class="font-semibold text-gray-900 truncate">${escapeHtml(content.name)}</h3>
                      <span class="inline-block text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded mt-1">${escapeHtml(category)}</span>
                      ${tags.length > 0 ? `
                        <div class="flex flex-wrap gap-1 mt-2">
                          ${tags.map(tag => `<span class="inline-block text-xs px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full">${escapeHtml(tag)}</span>`).join('')}
                        </div>
                      ` : ''}
                      ${content.desc ? `<p class="text-sm text-gray-500 mt-2 line-clamp-2">${escapeHtml(content.desc)}</p>` : ''}
                      ${row.providers.rating != null && row.providers.rating > 0 ? `
                        <div class="flex items-center gap-1 mt-2">
                          <span class="text-yellow-500 text-sm">&#9733;</span>
                          <span class="text-sm text-gray-600">${parseFloat(row.providers.rating).toFixed(1)}</span>
                        </div>
                      ` : ''}
                    </div>
                  </div>
                </a>
              `;
            }).join('')}
          </div>
        </section>
      `).join('');
    }

    // Extract and display all unique tags (in current language)
    const allTags = new Set();
    allProviders.forEach(provider => {
      const tags = parseTags(provider.providers.tags);
      tags.forEach(tag => allTags.add(tag));
    });

    if (allTags.size > 0) {
      searchTags.innerHTML = Array.from(allTags).map(tag => `
        <button class="text-xs px-3 py-1 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition-colors" data-tag="${escapeHtml(tag)}">
          ${escapeHtml(tag)}
        </button>
      `).join('');

      searchTags.addEventListener('click', function(e) {
        const tagButton = e.target.closest('[data-tag]');
        if (tagButton) {
          const tag = tagButton.dataset.tag;
          currentTagFilter = currentTagFilter === tag ? '' : tag;
          tagButton.classList.toggle('bg-blue-500', currentTagFilter === tag);
          tagButton.classList.toggle('text-white', currentTagFilter === tag);
          tagButton.classList.toggle('bg-blue-50', currentTagFilter !== tag);
          tagButton.classList.toggle('text-blue-700', currentTagFilter !== tag);
          filterProviders();
        }
      });
    }
  </script>
</BaseLayout>
