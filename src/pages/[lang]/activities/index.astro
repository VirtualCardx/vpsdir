---
import '../../../styles/global.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { isValidLocale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { activities, activitiesContent, activityCategories } from '../../../db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { richTextToPlainText } from '../../../lib/rich-text';

const lang = Astro.params.lang as string;
if (!isValidLocale(lang)) {
  return Astro.redirect('/zh/activities/');
}

const db = getDb(env.DB);

// Get categories
const categories = await db
  .select()
  .from(activityCategories)
  .orderBy(activityCategories.sort_order);

// Get published activities
const allActivitiesData = await db
  .select()
  .from(activities)
  .where(eq(activities.is_active, true))
  .orderBy(desc(activities.is_featured), desc(activities.published_at))
  .limit(50);

// Get content and category info for each activity
const allActivities = await Promise.all(
  allActivitiesData.map(async (activity) => {
    const content = await db
      .select()
      .from(activitiesContent)
      .where(and(eq(activitiesContent.activity_id, activity.id), eq(activitiesContent.lang, lang)))
      .limit(1)
      .then(rows => rows[0]);

    const category = await db
      .select()
      .from(activityCategories)
      .where(eq(activityCategories.id, activity.category_id))
      .limit(1)
      .then(rows => rows[0]);

    return {
      id: activity.id,
      slug: activity.slug,
      categoryId: activity.category_id,
      publishedAt: activity.published_at,
      isFeatured: activity.is_featured,
      viewCount: activity.view_count,
      title: content?.title || '',
      description: content?.description || '',
      content: content?.content || '',
      categorySlug: category?.slug || '',
      categoryIcon: category?.icon || '',
    };
  })
);

const siteName = t(lang, 'site.title');
const pageTitle = lang === 'zh' ? '最新活动' : 'Latest Activities';
const pageDesc = lang === 'zh'
  ? '查看最新的VPS优惠活动、产品更新和行业资讯'
  : 'Check out the latest VPS deals, product updates, and industry news';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} - {siteName}</title>
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`/activities/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${pageTitle} - ${siteName}`} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />

    <!-- Schema.org structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": pageTitle,
        "description": pageDesc,
        "mainEntity": {
          "@type": "ItemList",
          "itemListElement": allActivities.map((activity, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "item": {
              "@type": "Article",
              "headline": activity.title,
              "description": activity.description || richTextToPlainText(activity.content).slice(0, 160),
              "url": `${Astro.site}/${lang}/activity/${activity.slug}/`,
              "datePublished": activity.publishedAt,
              "genre": activity.categorySlug
            }
          }))
        }
      }
    </script>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 flex flex-col">
    <Header lang={lang} />

    <main class="flex-1 container mx-auto px-4 py-8">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4">{pageTitle}</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          {pageDesc}
        </p>
      </div>

      <!-- Category Filter -->
      <div class="flex justify-center gap-2 mb-8">
        <button class="px-4 py-2 rounded-full text-sm font-medium bg-gray-900 text-white">
          {lang === 'zh' ? '全部' : 'All'}
        </button>
        {categories.map((cat) => (
          <button class="px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-700 border border-gray-300 hover:bg-gray-50">
            {cat.slug}
          </button>
        ))}
      </div>

      <!-- Activities Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allActivities.map((activity) => (
          <article class="bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs">
                  {activity.categorySlug}
                </span>
                {activity.isFeatured && (
                  <span class="text-xs text-yellow-600">⭐ {lang === 'zh' ? '推荐' : 'Featured'}</span>
                )}
              </div>

              <h2 class="text-xl font-semibold mb-3 line-clamp-2">
                <a href={`/${lang}/activity/${activity.slug}/`} class="hover:text-blue-600 transition-colors">
                  {activity.title}
                </a>
              </h2>

              <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                {activity.description || richTextToPlainText(activity.content).slice(0, 150)}...
              </p>

              <div class="flex items-center justify-between text-xs text-gray-500">
                <time datetime={activity.publishedAt}>
                  {new Date(activity.publishedAt).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US')}
                </time>
                <span>{activity.viewCount} {lang === 'zh' ? '次浏览' : 'views'}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      {allActivities.length === 0 && (
        <div class="text-center py-12">
          <p class="text-gray-500">{lang === 'zh' ? '暂无活动' : 'No activities yet'}</p>
        </div>
      )}
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>