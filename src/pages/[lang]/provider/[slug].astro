---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isValidLocale } from '../../../i18n/config';
import { t, getProviderAlternateUrl } from '../../../i18n/utils';
import { getLogoUrl } from '../../../lib/r2';
import { getDb } from '../../../lib/db';
import { providers, providersContent } from '../../../db/schema';
import { eq, and } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { sanitizeRichText, richTextToPlainText } from '../../../lib/rich-text';

const lang = Astro.params.lang as string;
if (!isValidLocale(lang)) {
  return Astro.redirect('/zh/');
}

const slug = Astro.params.slug as string;
const db = getDb(env.DB);

// Find provider by slug
const field = lang === 'zh' ? 'slug_zh' : 'slug_en';
const provider = await db
  .select()
 .from(providers)
  .where(eq(providers[field], slug))
  .get();

if (!provider) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

// Get content for current language
const content = await db
  .select()
 .from(providersContent)
  .where(and(eq(providersContent.provider_id, provider.id), eq(providersContent.lang, lang)))
  .get();

const name = content?.name || (lang === 'zh' ? provider.slug_zh : provider.slug_en);
const desc = content?.desc;
const descText = richTextToPlainText(desc);
const categoryLabel = t(lang as Locale, `categories.${provider.category}`);
const metaTitle = content?.meta_title || `${name} - ${t(lang as Locale, 'site.brand')}`;
// 始终保证 meta description 有内容：DB > 正文摘要 > 通用兜底文案
const metaDesc = content?.meta_desc
  || descText
  || (lang === 'zh'
    ? `${name} 是一家${categoryLabel}服务商，查看 ${t(lang as Locale, 'site.brand')} 上的详细介绍、用户评分与网友评测。`
    : `${name} is a ${categoryLabel} provider. See detailed info, ratings and reviews on ${t(lang as Locale, 'site.brand')}.`);
const logoUrl = getLogoUrl(provider.logo_key, provider.updated_at);

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const alternates = locales.map((l) => ({
  lang: l,
  href: `${siteUrl}${getProviderAlternateUrl(l, provider.slug_zh, provider.slug_en)}`,
}));

// Parse tags JSON (supports both old flat array and new bilingual format)
const rawTags = provider.tags ? JSON.parse(provider.tags) : [];
const tags = rawTags.map(tag => {
  if (typeof tag === 'string') return tag;
  return tag[lang] || tag.zh || tag.en || '';
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name,
  url: provider.url,
  description: descText || undefined,
  aggregateRating: provider.rating
    ? { '@type': 'AggregateRating', ratingValue: provider.rating, bestRating: 5 }
    : undefined,
};

const categoryTagText = tags.length > 0 ? tags.slice(0, 6).join('、') : '';
const ratingText = provider.rating != null && provider.rating > 0 ? provider.rating.toFixed(1) : null;
const faqItems = [
  {
    q: lang === 'zh' ? `${name} 怎么样？` : `How is ${name}?`,
    a: lang === 'zh'
      ? `${name} 是一家${categoryLabel}服务商${ratingText ? `，当前目录评分为 ${ratingText}/5` : ''}${categoryTagText ? `，主要特点包括：${categoryTagText}` : ''}。本页汇总其服务范围与适用场景；下单前请以官网最新价格、库存与条款为准。`
      : `${name} is a ${categoryLabel} provider${ratingText ? ` currently rated ${ratingText}/5 in this directory` : ''}${categoryTagText ? `, with key attributes including ${categoryTagText}` : ''}. This page summarizes its services and use cases; verify current pricing, stock and terms on the official site before ordering.`,
  },
  {
    q: lang === 'zh' ? `${name} 适合什么场景？` : `What is ${name} suitable for?`,
    a: lang === 'zh'
      ? `${name} 的服务定位围绕${categoryLabel}展开${categoryTagText ? `，目录标签「${categoryTagText}」反映了主要方向` : ''}。选择前应先确认节点位置、预算、流量、退款和续费要求，再与同类服务商比较。`
      : `${name} focuses on ${categoryLabel} services${categoryTagText ? `; the directory tags “${categoryTagText}” indicate its main positioning` : ''}. Check location, budget, traffic, refund and renewal requirements before comparing it with alternatives.`,
  },
  {
    q: lang === 'zh' ? `如何访问 ${name} 官网？` : `How do I visit ${name}?`,
    a: lang === 'zh'
      ? `点击本页的「访问官网」按钮即可打开 ${name} 官方网站。促销、库存和价格可能变化，请在付款前再次核对。`
      : `Use the “Visit Website” button on this page to open the official ${name} website. Promotions, stock and prices may change, so verify them again before payment.`,
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  lang={lang}
  alternates={alternates}
  jsonLd={jsonLd}
  extraJsonLd={[faqJsonLd]}
  xDefault={`${siteUrl}${getProviderAlternateUrl('zh', provider.slug_zh, provider.slug_en)}`}
>
  <div class="max-w-4xl mx-auto pt-3">
    <a href={`/${lang}/`} class="text-sm text-gray-500 hover:text-gray-700 mb-6 inline-block">
      &larr; {t(lang, 'common.back')}
    </a>

    <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-sm">
      <div class="flex items-start gap-6">
        <img
          src={logoUrl}
          alt={name}
          class="provider-logo w-20 h-20 rounded-xl object-contain flex-shrink-0"
          width="80"
          height="80"
        />
        <div class="flex-1">
          <h1 class="text-3xl font-bold tracking-tight text-gray-900">{name}</h1>
          <span class="inline-block text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded mt-2">
            {t(lang, `categories.${provider.category}`)}
          </span>
          {provider.rating != null && provider.rating > 0 && (
            <div class="mt-2">
              <div class="flex items-center gap-1">
                <span class="text-yellow-500">&#9733;</span>
                <span class="text-gray-700 font-medium">{provider.rating.toFixed(1)}</span>
                <span class="text-gray-600 text-sm">/ 5</span>
              </div>
              <p class="text-xs text-gray-600 mt-1">
                {lang === 'zh' ? '编辑综合评分，不是用户评价平均分。' : 'Editorial composite, not a user-review average.'}
              </p>
            </div>
          )}
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-3">
              {tags.map((tag) => (
                <span class="inline-block text-xs px-2 py-1 tag-chip rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <a
            href={provider.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex w-full sm:w-auto justify-center items-center gap-2 bg-gray-900 text-white px-5 py-2.5 rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium"
          >
            {t(lang, 'provider.visit')} &rarr;
          </a>
        </div>
      </div>

      {desc && (
        <div class="mt-6 pt-6 border-t border-gray-100">
          <h2 class="text-lg font-semibold text-gray-800 mb-2">{t(lang, 'provider.description')}</h2>
          <div class="prose prose-sm max-w-none text-gray-600" set:html={sanitizeRichText(desc) || ''} />
        </div>
      )}

      <div class="mt-6 pt-6 border-t border-gray-100">
        <p class="text-xs text-gray-600">
          {lang === 'zh'
            ? '信息由 VPSDEX 编辑整理；价格、库存与条款以服务商官网为准。'
            : 'Information is reviewed by VPSDEX editors; pricing, stock and terms are subject to the provider website.'}
        </p>
        <p class="text-xs mt-2">
          <a class="text-teal-700 hover:underline" href={`/${lang}/methodology/`}>
            {lang === 'zh' ? '查看评测方法' : 'Review methodology'}
          </a>
          <span class="text-gray-400 mx-2">·</span>
          <a class="text-teal-700 hover:underline" href={`/${lang}/disclosure/`}>
            {lang === 'zh' ? '商业关系披露' : 'Commercial disclosure'}
          </a>
        </p>
      </div>
    </div>

    <section class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-sm mt-6" aria-labelledby="provider-faq">
      <h2 id="provider-faq" class="text-lg font-semibold text-gray-800 mb-4">
        {lang === 'zh' ? '常见问题' : 'Frequently asked questions'}
      </h2>
      <div class="space-y-5">
        {faqItems.map((item) => (
          <div>
            <h3 class="font-semibold text-gray-900 text-sm mb-1">{item.q}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
