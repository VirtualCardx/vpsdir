---
import '../../../styles/global.css';
import AdminHeader from '../../../components/AdminHeader.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { providers, providersContent } from '../../../db/schema';
import { eq, and } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const lang: Locale = 'zh';
const db = getDb(env.DB);

const id = Number(Astro.params.id);
if (isNaN(id)) return Astro.redirect('/admin/');

const provider = await db.select().from(providers).where(eq(providers.id, id)).get();
if (!provider) return Astro.redirect('/admin/');

const contentZh = await db
  .select()
  .from(providersContent)
  .where(and(eq(providersContent.provider_id, id), eq(providersContent.lang, 'zh')))
  .get();

const contentEn = await db
  .select()
  .from(providersContent)
  .where(and(eq(providersContent.provider_id, id), eq(providersContent.lang, 'en')))
  .get();

const categories = ['vps', 'domain', 'email', 'hosting', 'cdn'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'admin.editProvider')} - {contentZh?.name || provider.slug_en}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title={t(lang, 'admin.editProvider')}
      subtitle={contentZh?.name || provider.slug_en}
      backHref="/admin/"
      backLabel={t(lang, 'common.back')}
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard'), current: true },
        { href: '/admin/activities/', label: '活动管理' },
      ]}
    >
      <Fragment slot="actions">
        <form method="POST" action="/api/auth/logout" class="inline">
          <button
            type="submit"
            class="text-sm px-3 py-1.5 text-gray-600 hover:text-gray-900 transition-colors"
          >
            {t(lang, 'admin.logout')}
          </button>
        </form>
      </Fragment>
    </AdminHeader>

    <main class="container mx-auto px-4 py-6 max-w-3xl">
      <form method="POST" action={`/api/admin/providers?id=${id}&_method=PUT`} enctype="multipart/form-data" class="bg-white rounded-lg border border-gray-200 p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.slug')} (中文)</label>
            <input type="text" name="slug_zh" required value={provider.slug_zh} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.slug')} (EN)</label>
            <input type="text" name="slug_en" required value={provider.slug_en} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.name')} (中文)</label>
            <input type="text" name="name_zh" required value={contentZh?.name || ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.name')} (EN)</label>
            <input type="text" name="name_en" required value={contentEn?.name || ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.url')}</label>
            <input type="url" name="url" required value={provider.url} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'provider.category')}</label>
            <select name="category" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm">
              {categories.map((cat) => (
                <option value={cat} selected={cat === provider.category}>{t(lang, `categories.${cat}`)}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'provider.rating')}</label>
            <input type="number" name="rating" min="0" max="5" step="0.1" value={provider.rating ?? ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">自定义标签</label>
            <div class="border border-gray-300 rounded p-3 bg-gray-50">
              <input type="hidden" name="tags" id="tags-input-edit" value={provider.tags || '[]'} />
              <div id="tags-container-edit" class="flex flex-wrap gap-2 mb-2">
                <!-- Tags will appear here -->
              </div>
              <div class="flex gap-2">
                <input type="text" id="new-tag-edit" class="flex-1 px-2 py-1 border border-gray-300 rounded text-sm" placeholder="输入标签名" />
                <button type="button" id="add-tag-edit" class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">添加</button>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.logo')}</label>
            <div class="grid grid-cols-2 gap-4">
              {provider.logo_key && (
                <div class="border border-gray-200 rounded-lg p-3 bg-gray-50">
                  <p class="text-xs font-medium text-gray-600 mb-2">当前Logo</p>
                  <div class="flex items-center justify-center h-24 bg-white rounded border border-gray-200">
                    <img src={`/api/logo/${provider.logo_key}`} alt="当前Logo" class="max-h-full max-w-full object-contain" />
                  </div>
                </div>
              )}
              <div class={provider.logo_key ? '' : 'col-span-2'}>
                <div id="logo-upload-area-edit" class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-blue-400 transition-colors cursor-pointer bg-gray-50">
                  <input type="file" name="logo" accept="image/*" class="hidden" id="logo-input-edit" />
                  <div id="upload-placeholder-edit">
                    <svg class="mx-auto h-10 w-10 text-gray-400 mb-2" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                      <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <p class="text-sm text-gray-600">{provider.logo_key ? '点击更换新Logo' : '点击或拖拽上传Logo'}</p>
                    <p class="text-xs text-gray-400 mt-1">支持 PNG, JPG, GIF, SVG 格式</p>
                  </div>
                  <div id="logo-preview-edit" class="hidden">
                    <div class="flex items-center justify-center h-24 bg-white rounded border border-blue-200 mb-2">
                      <img id="logo-image-edit" src="" alt="新Logo预览" class="max-h-full max-w-full object-contain" />
                    </div>
                    <p class="text-xs text-blue-600 font-medium">新Logo预览</p>
                    <button type="button" id="remove-logo-edit" class="mt-2 text-xs text-red-600 hover:text-red-700">取消新Logo</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <input type="checkbox" name="is_active" id="is_active" checked={provider.is_active} class="rounded" />
            <label for="is_active" class="text-sm font-medium text-gray-700">{t(lang, 'admin.active')}</label>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.desc')} (中文)</label>
            <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="请输入服务商中文描述，支持标题、列表、引用、代码块和图片">
              <input type="hidden" name="desc_zh" data-rich-text-input value={contentZh?.desc || ''} />
              <div class="tiptap-toolbar" data-rich-text-toolbar></div>
              <div data-rich-text-editor></div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.desc')} (EN)</label>
            <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="Enter the provider description in English with headings, lists, quotes, code blocks, and images">
              <input type="hidden" name="desc_en" data-rich-text-input value={contentEn?.desc || ''} />
              <div class="tiptap-toolbar" data-rich-text-toolbar></div>
              <div data-rich-text-editor></div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.metaTitle')} (中文)</label>
            <input type="text" name="meta_title_zh" value={contentZh?.meta_title || ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.metaTitle')} (EN)</label>
            <input type="text" name="meta_title_en" value={contentEn?.meta_title || ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.metaDesc')} (中文)</label>
            <input type="text" name="meta_desc_zh" value={contentZh?.meta_desc || ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t(lang, 'admin.metaDesc')} (EN)</label>
            <input type="text" name="meta_desc_en" value={contentEn?.meta_desc || ''} class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded text-sm hover:bg-gray-700 transition-colors">
            {t(lang, 'admin.save')}
          </button>
          <a href="/admin/" class="text-sm text-gray-500 hover:text-gray-700">{t(lang, 'admin.cancel')}</a>
        </div>
      </form>
    </main>

    <script>
      import { initAdminRichTextEditors } from '../../../scripts/admin-rich-text';
      initAdminRichTextEditors();

      // Tag management
      const tagsInput = document.getElementById('tags-input-edit');
      const tagsContainer = document.getElementById('tags-container-edit');
      const newTagInput = document.getElementById('new-tag-edit');
      const addTagButton = document.getElementById('add-tag-edit');

      let tags = JSON.parse(tagsInput.value || '[]');

      function renderTags() {
        tagsContainer.innerHTML = tags.map(tag => `
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs">
            ${tag}
            <button type="button" class="hover:text-blue-900" data-tag="${tag}">&times;</button>
          </span>
        `).join('');

        tagsInput.value = JSON.stringify(tags);
      }

      // Initialize tags
      renderTags();

      addTagButton.addEventListener('click', function() {
        const tag = newTagInput.value.trim();
        if (tag && !tags.includes(tag)) {
          tags.push(tag);
          newTagInput.value = '';
          renderTags();
        }
      });

      newTagInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addTagButton.click();
        }
      });

      tagsContainer.addEventListener('click', function(e) {
        const button = e.target.closest('[data-tag]');
        if (button) {
          const tag = button.dataset.tag;
          tags = tags.filter(t => t !== tag);
          renderTags();
        }
      });

      // Logo upload
      const logoInput = document.getElementById('logo-input-edit');
      const logoUploadArea = document.getElementById('logo-upload-area-edit');
      const uploadPlaceholder = document.getElementById('upload-placeholder-edit');
      const logoPreview = document.getElementById('logo-preview-edit');
      const logoImage = document.getElementById('logo-image-edit');
      const removeLogo = document.getElementById('remove-logo-edit');

      // Click to upload
      logoUploadArea.addEventListener('click', function(e) {
        if (e.target !== removeLogo && !e.target.closest('#tags-container-edit') && !e.target.closest('#new-tag-edit') && !e.target.closest('#add-tag-edit')) {
          logoInput.click();
        }
      });

      // File selection
      logoInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          showPreview(file);
        }
      });

      // Drag and drop
      logoUploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        logoUploadArea.classList.add('border-blue-400', 'bg-blue-50');
      });

      logoUploadArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        logoUploadArea.classList.remove('border-blue-400', 'bg-blue-50');
      });

      logoUploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        logoUploadArea.classList.remove('border-blue-400', 'bg-blue-50');

        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
          logoInput.files = e.dataTransfer.files;
          showPreview(file);
        }
      });

      function showPreview(file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          logoImage.src = e.target.result;
          uploadPlaceholder.classList.add('hidden');
          logoPreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }

      // Remove new logo
      removeLogo.addEventListener('click', function(e) {
        e.stopPropagation();
        logoInput.value = '';
        logoImage.src = '';
        uploadPlaceholder.classList.remove('hidden');
        logoPreview.classList.add('hidden');
      });
    </script>
  </body>
</html>
