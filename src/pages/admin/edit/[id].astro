---
import '../../../styles/global.css';
import AdminHeader from '../../../components/AdminHeader.astro';
import AdminHeaderActions from '../../../components/AdminHeaderActions.astro';
import AdminFormPage from '../../../components/AdminFormPage.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { providers, providersContent } from '../../../db/schema';
import { eq, and } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const lang: Locale = 'zh';
const db = getDb(env.DB);

const id = Number(Astro.params.id);
if (isNaN(id)) return Astro.redirect('/admin/');

const provider = await db.select().from(providers).where(eq(providers.id, id)).get();
if (!provider) return Astro.redirect('/admin/');

const contentZh = await db
  .select()
  .from(providersContent)
  .where(and(eq(providersContent.provider_id, id), eq(providersContent.lang, 'zh')))
  .get();

const contentEn = await db
  .select()
  .from(providersContent)
  .where(and(eq(providersContent.provider_id, id), eq(providersContent.lang, 'en')))
  .get();

const categories = ['vps', 'domain', 'email', 'hosting', 'cdn'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'admin.editProvider')} - {contentZh?.name || provider.slug_en}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title={t(lang, 'admin.editProvider')}
      subtitle={contentZh?.name || provider.slug_en}
      backHref="/admin/"
      backLabel={t(lang, 'common.back')}
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard'), current: true },
        { href: '/admin/activities/', label: '活动管理' },
        { href: '/admin/settings', label: t(lang, 'admin.userSettings') },
      ]}
    >
      <Fragment slot="actions">
        <AdminHeaderActions logoutLabel={t(lang, 'admin.logout')} />
      </Fragment>
    </AdminHeader>

    <AdminFormPage
      action={`/api/admin/providers?id=${id}&_method=PUT`}
      enctype="multipart/form-data"
      formClass="space-y-4"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">{t(lang, 'admin.slug')} (中文)</label>
            <input type="text" name="slug_zh" required value={provider.slug_zh} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.slug')} (EN)</label>
            <input type="text" name="slug_en" required value={provider.slug_en} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.name')} (中文)</label>
            <input type="text" name="name_zh" required value={contentZh?.name || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.name')} (EN)</label>
            <input type="text" name="name_en" required value={contentEn?.name || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.url')}</label>
            <input type="url" name="url" required value={provider.url} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'provider.category')}</label>
            <select name="category" required class="admin-input">
              {categories.map((cat) => (
                <option value={cat} selected={cat === provider.category}>{t(lang, `categories.${cat}`)}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="admin-label">{t(lang, 'provider.rating')}</label>
            <input type="number" name="rating" min="0" max="5" step="0.1" value={provider.rating ?? ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">自定义标签</label>
            <div class="border border-gray-300 rounded p-3 bg-gray-50">
              <input type="hidden" name="tags" id="tags-input-edit" value={provider.tags || '[]'} />
              <div id="tags-container-edit" class="flex flex-wrap gap-2 mb-2">
                <!-- Tags will appear here -->
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-1">
                  <input type="text" id="new-tag-zh-edit" class="admin-input" placeholder="中文标签" />
                </div>
                <div class="flex-1">
                  <input type="text" id="new-tag-en-edit" class="admin-input" placeholder="English tag" />
                </div>
                <button type="button" id="add-tag-edit" class="admin-btn admin-btn-accent whitespace-nowrap">添加</button>
              </div>
            </div>
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.logo')}</label>
            <div class="space-y-3">
              {provider.logo_key && (
                <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                  <p class="admin-label mb-2">当前Logo</p>
                  <div class="flex items-center justify-center h-24 bg-white rounded border border-gray-200">
                    <img
                      src={`/api/logo/${provider.logo_key}`}
                      alt="当前Logo"
                      class="h-20 w-auto object-contain rounded"
                    />
                  </div>
                </div>
              )}
              <div
                id="logo-upload-area-edit"
                class="admin-upload-area"
              >
                <input type="file" name="logo" accept="image/*" class="hidden" id="logo-input-edit" />
                <div id="upload-placeholder-edit">
                  <svg class="mx-auto h-12 w-12 text-gray-400 mb-2" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <p class="admin-upload-text">{provider.logo_key ? '点击或拖拽图片到此处更换' : '点击或拖拽图片到此处上传'}</p>
                  <p class="admin-upload-subtext">支持 PNG, JPG, GIF, SVG 格式</p>
                </div>
                <div id="logo-preview-edit" class="hidden">
                  <img id="logo-image-edit" src="" alt="新Logo预览" class="h-20 w-auto object-contain mx-auto rounded" />
                  <p class="admin-help-text mt-2">点击更换图片</p>
                  <button type="button" id="remove-logo-edit" class="mt-2 admin-btn-danger">取消新Logo</button>
                </div>
              </div>
            </div>
          </div>
          <div class="admin-checkbox-row">
            <input type="checkbox" name="is_active" id="is_active" checked={provider.is_active} class="admin-checkbox" />
            <label for="is_active" class="admin-checkbox-label">{t(lang, 'admin.active')}</label>
          </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">{t(lang, 'admin.desc')} (中文)</label>
            <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="请输入服务商中文描述，支持标题、列表、引用、代码块和图片">
              <input type="hidden" name="desc_zh" data-rich-text-input value={contentZh?.desc || ''} />
              <div class="tiptap-toolbar" data-rich-text-toolbar></div>
              <div data-rich-text-editor></div>
            </div>
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.desc')} (EN)</label>
            <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="Enter the provider description in English with headings, lists, quotes, code blocks, and images">
              <input type="hidden" name="desc_en" data-rich-text-input value={contentEn?.desc || ''} />
              <div class="tiptap-toolbar" data-rich-text-toolbar></div>
              <div data-rich-text-editor></div>
            </div>
          </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">{t(lang, 'admin.metaTitle')} (中文)</label>
            <input type="text" name="meta_title_zh" value={contentZh?.meta_title || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.metaTitle')} (EN)</label>
            <input type="text" name="meta_title_en" value={contentEn?.meta_title || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.metaDesc')} (中文)</label>
            <input type="text" name="meta_desc_zh" value={contentZh?.meta_desc || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">{t(lang, 'admin.metaDesc')} (EN)</label>
            <input type="text" name="meta_desc_en" value={contentEn?.meta_desc || ''} class="admin-input" />
          </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="admin-btn admin-btn-primary">
          {t(lang, 'admin.save')}
        </button>
        <a
          href="/admin/"
          class="admin-btn admin-btn-secondary"
        >
          {t(lang, 'admin.cancel')}
        </a>
      </div>
    </AdminFormPage>

    <script>
      import { initAdminRichTextEditors } from '../../../scripts/admin-rich-text';
      initAdminRichTextEditors();

      // Tag management
      const tagsInput = document.getElementById('tags-input-edit');
      const tagsContainer = document.getElementById('tags-container-edit');
      const newTagZhInput = document.getElementById('new-tag-zh-edit');
      const newTagEnInput = document.getElementById('new-tag-en-edit');
      const addTagButton = document.getElementById('add-tag-edit');

      // Parse tags, migrating old flat array format to bilingual objects
      let rawTags = JSON.parse(tagsInput.value || '[]');
      let tags = rawTags.map(tag => {
        if (typeof tag === 'string') {
          return { zh: tag, en: tag };
        }
        return tag;
      });

      function renderTags() {
        tagsContainer.innerHTML = tags.map((tag, i) => `
          <span class="admin-tag-pill">
            ${tag.zh}${tag.en ? ' / ' + tag.en : ''}
            <button type="button" class="admin-tag-pill-remove" data-tag-idx="${i}">&times;</button>
          </span>
        `).join('');

        tagsInput.value = JSON.stringify(tags);
      }

      // Initialize tags
      renderTags();

      addTagButton.addEventListener('click', function() {
        const zh = newTagZhInput.value.trim();
        const en = newTagEnInput.value.trim();
        if (zh || en) {
          tags.push({ zh: zh || en, en: en || zh });
          newTagZhInput.value = '';
          newTagEnInput.value = '';
          renderTags();
        }
      });

      newTagZhInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addTagButton.click();
        }
      });

      newTagEnInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addTagButton.click();
        }
      });

      tagsContainer.addEventListener('click', function(e) {
        const button = e.target.closest('[data-tag-idx]');
        if (button) {
          const idx = parseInt(button.dataset.tagIdx);
          tags.splice(idx, 1);
          renderTags();
        }
      });

      // Logo upload
      const logoInput = document.getElementById('logo-input-edit');
      const logoUploadArea = document.getElementById('logo-upload-area-edit');
      const uploadPlaceholder = document.getElementById('upload-placeholder-edit');
      const logoPreview = document.getElementById('logo-preview-edit');
      const logoImage = document.getElementById('logo-image-edit');
      const removeLogo = document.getElementById('remove-logo-edit');

      // Click to upload
      logoUploadArea.addEventListener('click', function(e) {
        if (e.target !== removeLogo && !e.target.closest('#tags-container-edit') && !e.target.closest('#new-tag-edit') && !e.target.closest('#add-tag-edit')) {
          logoInput.click();
        }
      });

      // File selection
      logoInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          showPreview(file);
        }
      });

      // Drag and drop
      logoUploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        logoUploadArea.classList.add('border-blue-400', 'bg-blue-50');
      });

      logoUploadArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        logoUploadArea.classList.remove('border-blue-400', 'bg-blue-50');
      });

      logoUploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        logoUploadArea.classList.remove('border-blue-400', 'bg-blue-50');

        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
          logoInput.files = e.dataTransfer.files;
          showPreview(file);
        }
      });

      function showPreview(file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          logoImage.src = e.target.result;
          uploadPlaceholder.classList.add('hidden');
          logoPreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }

      // Remove new logo
      removeLogo.addEventListener('click', function(e) {
        e.stopPropagation();
        logoInput.value = '';
        logoImage.src = '';
        uploadPlaceholder.classList.remove('hidden');
        logoPreview.classList.add('hidden');
      });
    </script>
  </body>
</html>
