---
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
import AdminAlert from '../../components/AdminAlert.astro';
import AdminHeaderActions from '../../components/AdminHeaderActions.astro';
import AdminDataTable from '../../components/AdminDataTable.astro';
import AdminFormPage from '../../components/AdminFormPage.astro';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { getDb } from '../../lib/db';
import { providers, providersContent } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import { getLastUpdated } from '../../lib/cache';
import { env } from 'cloudflare:workers';

const lang: Locale = 'zh';
const db = getDb(env.DB);

const allProviders = await db
  .select()
  .from(providers)
  .leftJoin(
    providersContent,
    and(eq(providers.id, providersContent.provider_id), eq(providersContent.lang, 'zh')),
  )
  .orderBy(providers.id);

const lastUpdated = await getLastUpdated(env.VPSDIR_KV);
const message = Astro.url.searchParams.get('msg');

const categories = ['vps', 'domain', 'email', 'hosting', 'cdn'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'admin.dashboard')}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title={t(lang, 'admin.dashboard')}
      subtitle="统一管理服务商与活动内容"
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard'), current: true },
        { href: '/admin/activities/', label: '活动管理' },
        { href: '/admin/settings', label: t(lang, 'admin.userSettings') },
      ]}
    >
      <Fragment slot="actions">
        <AdminHeaderActions
          metaText={lastUpdated ? `Last cache: ${new Date(lastUpdated).toLocaleString('zh-CN')}` : undefined}
          refreshAction="/api/admin/cache-refresh"
          refreshLabel={t(lang, 'admin.refreshCache')}
          logoutLabel={t(lang, 'admin.logout')}
        />
      </Fragment>
    </AdminHeader>

    <main class="container mx-auto px-4 py-6">
      {message && (
        <AdminAlert>
          {message === 'cache_refreshed' ? t(lang, 'admin.cacheRefreshed') : message === 'saved' ? '保存成功' : message === 'deleted' ? '删除成功' : message}
        </AdminAlert>
      )}

      <!-- Add Provider Form -->
      <AdminFormPage
        title={t(lang, 'admin.addProvider')}
        class="mb-6"
        action="/api/admin/providers"
        enctype="multipart/form-data"
        formClass="space-y-4"
        wrapMain={false}
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">{t(lang, 'admin.slug')} (中文)</label>
              <input type="text" name="slug_zh" required class="admin-input" placeholder="example-provider" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.slug')} (EN)</label>
              <input type="text" name="slug_en" required class="admin-input" placeholder="example-provider" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.name')} (中文)</label>
              <input type="text" name="name_zh" required class="admin-input" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.name')} (EN)</label>
              <input type="text" name="name_en" required class="admin-input" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.url')}</label>
              <input type="url" name="url" required class="admin-input" placeholder="https://" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'provider.category')}</label>
              <select name="category" required class="admin-input">
                {categories.map((cat) => (
                  <option value={cat}>{t(lang, `categories.${cat}`)}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="admin-label">{t(lang, 'provider.rating')}</label>
              <input type="number" name="rating" min="0" max="5" step="0.1" class="admin-input" placeholder="0-5" />
            </div>
            <div>
              <label class="admin-label">自定义标签</label>
              <div class="border border-gray-300 rounded p-3 bg-gray-50">
                <input type="hidden" name="tags" id="tags-input-add" />
                <div id="tags-container-add" class="flex flex-wrap gap-2 mb-2">
                  <!-- Tags will appear here -->
                </div>
                <div class="flex gap-2 items-end">
                  <div class="flex-1">
                    <input type="text" id="new-tag-zh-add" class="admin-input" placeholder="中文标签" />
                  </div>
                  <div class="flex-1">
                    <input type="text" id="new-tag-en-add" class="admin-input" placeholder="English tag" />
                  </div>
                  <button type="button" id="add-tag-add" class="admin-btn admin-btn-accent whitespace-nowrap">添加</button>
                </div>
              </div>
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.logo')}</label>
              <div id="logo-upload-area-add" class="admin-upload-area">
                <input type="file" name="logo" accept="image/*" class="hidden" id="logo-input-add" />
                <div id="upload-placeholder-add">
                  <svg class="mx-auto h-12 w-12 text-gray-400 mb-2" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <p class="admin-upload-text">点击或拖拽图片到此处上传</p>
                  <p class="admin-upload-subtext">支持 PNG, JPG, GIF, SVG 格式</p>
                </div>
                <div id="logo-preview-add" class="hidden">
                  <img id="logo-image-add" src="" alt="Logo预览" class="h-20 w-auto object-contain mx-auto rounded" />
                  <p class="admin-help-text mt-2">点击更换图片</p>
                  <button type="button" id="remove-logo-add" class="mt-2 admin-btn-danger">删除</button>
                </div>
              </div>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">{t(lang, 'admin.desc')} (中文)</label>
              <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="请输入服务商中文描述，支持标题、列表、引用、代码块和图片">
                <input type="hidden" name="desc_zh" data-rich-text-input value="" />
                <div class="tiptap-toolbar" data-rich-text-toolbar></div>
                <div data-rich-text-editor></div>
              </div>
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.desc')} (EN)</label>
              <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="Enter the provider description in English with headings, lists, quotes, code blocks, and images">
                <input type="hidden" name="desc_en" data-rich-text-input value="" />
                <div class="tiptap-toolbar" data-rich-text-toolbar></div>
                <div data-rich-text-editor></div>
              </div>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">{t(lang, 'admin.metaTitle')} (中文)</label>
              <input type="text" name="meta_title_zh" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.metaTitle')} (EN)</label>
              <input type="text" name="meta_title_en" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.metaDesc')} (中文)</label>
              <input type="text" name="meta_desc_zh" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">{t(lang, 'admin.metaDesc')} (EN)</label>
              <input type="text" name="meta_desc_en" class="admin-input" />
            </div>
        </div>
        <button type="submit" class="admin-btn admin-btn-primary">
          {t(lang, 'admin.save')}
        </button>
      </AdminFormPage>

      <!-- Provider List -->
      <AdminDataTable headClass="bg-gray-50 border-b border-gray-200" bodyClass="divide-y divide-gray-100">
        <Fragment slot="head">
          <tr>
            <th class="admin-table-head">ID</th>
            <th class="admin-table-head">{t(lang, 'admin.name')}</th>
            <th class="admin-table-head">{t(lang, 'provider.category')}</th>
            <th class="admin-table-head">{t(lang, 'admin.active')}</th>
            <th class="admin-table-head">{t(lang, 'admin.actions')}</th>
          </tr>
        </Fragment>

        {allProviders.length === 0 ? (
          <tr>
            <td colspan="5" class="admin-empty-state-table">
              {t(lang, 'admin.noProviders')}
            </td>
          </tr>
        ) : (
          allProviders.map((row) => (
            <tr class="hover:bg-gray-50">
              <td class="admin-cell-muted">{row.providers.id}</td>
              <td class="admin-cell-strong">
                {row.providers_content?.name || row.providers.slug_en}
              </td>
              <td class="admin-cell">
                <span class="admin-badge admin-badge-muted">
                  {t(lang, `categories.${row.providers.category}`)}
                </span>
              </td>
              <td class="admin-cell">
                <span class:list={[
                  'admin-badge',
                  row.providers.is_active ? 'admin-badge-success' : 'admin-badge-danger',
                ]}>
                  {row.providers.is_active ? 'Active' : 'Inactive'}
                </span>
              </td>
              <td class="admin-cell">
                <div class="flex items-center gap-2">
                  <a href={`/admin/edit/${row.providers.id}`} class="admin-action-link">
                    {t(lang, 'admin.edit')}
                  </a>
                  <form method="POST" action={`/api/admin/providers?id=${row.providers.id}&_method=DELETE`} class="inline"
                    onsubmit={`return confirm('${t(lang, 'admin.confirm_delete')}')`}>
                    <button type="submit" class="admin-btn-danger">
                      {t(lang, 'admin.delete')}
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        )}
      </AdminDataTable>
    </main>

    <script>
      import { initAdminRichTextEditors } from '../../scripts/admin-rich-text';
      initAdminRichTextEditors();

      // Tag management
      const tagsInput = document.getElementById('tags-input-add');
      const tagsContainer = document.getElementById('tags-container-add');
      const newTagZhInput = document.getElementById('new-tag-zh-add');
      const newTagEnInput = document.getElementById('new-tag-en-add');
      const addTagButton = document.getElementById('add-tag-add');

      let tags = [];

      function renderTags() {
        tagsContainer.innerHTML = tags.map((tag, i) => `
          <span class="admin-tag-pill">
            ${tag.zh}${tag.en ? ' / ' + tag.en : ''}
            <button type="button" class="admin-tag-pill-remove" data-tag-idx="${i}">&times;</button>
          </span>
        `).join('');

        tagsInput.value = JSON.stringify(tags);
      }

      addTagButton.addEventListener('click', function() {
        const zh = newTagZhInput.value.trim();
        const en = newTagEnInput.value.trim();
        if (zh || en) {
          tags.push({ zh: zh || en, en: en || zh });
          newTagZhInput.value = '';
          newTagEnInput.value = '';
          renderTags();
        }
      });

      newTagZhInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addTagButton.click();
        }
      });

      newTagEnInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addTagButton.click();
        }
      });

      tagsContainer.addEventListener('click', function(e) {
        const button = e.target.closest('[data-tag-idx]');
        if (button) {
          const idx = parseInt(button.dataset.tagIdx);
          tags.splice(idx, 1);
          renderTags();
        }
      });

      // Logo upload
      const logoInput = document.getElementById('logo-input-add');
      const logoUploadArea = document.getElementById('logo-upload-area-add');
      const uploadPlaceholder = document.getElementById('upload-placeholder-add');
      const logoPreview = document.getElementById('logo-preview-add');
      const logoImage = document.getElementById('logo-image-add');
      const removeLogo = document.getElementById('remove-logo-add');

      // Click to upload
      logoUploadArea.addEventListener('click', function(e) {
        if (e.target !== removeLogo && !e.target.closest('#tags-container-add') && !e.target.closest('#new-tag-add') && !e.target.closest('#add-tag-add')) {
          logoInput.click();
        }
      });

      // File selection
      logoInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          showPreview(file);
        }
      });

      // Drag and drop
      logoUploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        logoUploadArea.classList.add('border-blue-400', 'bg-blue-50');
      });

      logoUploadArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        logoUploadArea.classList.remove('border-blue-400', 'bg-blue-50');
      });

      logoUploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        logoUploadArea.classList.remove('border-blue-400', 'bg-blue-50');

        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
          logoInput.files = e.dataTransfer.files;
          showPreview(file);
        }
      });

      function showPreview(file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          logoImage.src = e.target.result;
          uploadPlaceholder.classList.add('hidden');
          logoPreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }

      // Remove logo
      removeLogo.addEventListener('click', function(e) {
        e.stopPropagation();
        logoInput.value = '';
        logoImage.src = '';
        uploadPlaceholder.classList.remove('hidden');
        logoPreview.classList.add('hidden');
      });
    </script>
  </body>
</html>
