---
import '../../../styles/global.css';
import AdminHeader from '../../../components/AdminHeader.astro';
import AdminAlert from '../../../components/AdminAlert.astro';
import AdminHeaderActions from '../../../components/AdminHeaderActions.astro';
import AdminFormPage from '../../../components/AdminFormPage.astro';
import AdminDataTable from '../../../components/AdminDataTable.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { activities, activitiesContent } from '../../../db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getActivityImageUrl } from '../../../lib/r2';

const lang: Locale = 'zh';
const db = getDb(env.DB);

type ActivityListItem = {
  id: number;
  slug: string;
  categoryId: number;
  publishedAt: string;
  isFeatured: boolean;
  isActive: boolean;
  viewCount: number;
  createdAt: string;
  titleZh: string;
  featuredImageKey: string | null;
};

// Check if tables exist first
let allActivities: ActivityListItem[] = [];

try {
  // Get activities with Chinese content.
  const activityRows = await db
    .select({
      id: activities.id,
      slug: activities.slug,
      categoryId: activities.category_id,
      publishedAt: activities.published_at,
      isFeatured: activities.is_featured,
      isActive: activities.is_active,
      viewCount: activities.view_count,
      createdAt: activities.created_at,
      titleZh: activitiesContent.title,
      featuredImageKey: activities.featured_image_key,
    })
    .from(activities)
    .leftJoin(
      activitiesContent,
      and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, 'zh')),
    )
    .orderBy(desc(activities.published_at))
    .limit(50);

  allActivities = activityRows.map((row) => ({
    id: row.id,
    slug: row.slug,
    categoryId: row.categoryId,
    publishedAt: row.publishedAt,
    isFeatured: row.isFeatured,
    isActive: row.isActive,
    viewCount: row.viewCount,
    createdAt: row.createdAt,
    titleZh: row.titleZh || '',
    featuredImageKey: row.featuredImageKey,
  }));
} catch (error) {
  console.error('Database query error:', error);
  // Set empty arrays if tables don't exist yet
  allActivities = [];
}

const message = Astro.url.searchParams.get('msg');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>活动管理 - 管理后台</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title="活动管理"
      subtitle="发布、编辑与下线站点活动内容"
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard') },
        { href: '/admin/activities/', label: '活动管理', current: true },
        { href: '/admin/settings', label: t(lang, 'admin.userSettings') },
      ]}
    >
      <Fragment slot="actions">
        <AdminHeaderActions logoutLabel={t(lang, 'admin.logout')} />
      </Fragment>
    </AdminHeader>

    <main class="container mx-auto px-4 py-6">
      {message && (
        <AdminAlert>
          {message === 'created' ? '创建成功' : message === 'updated' ? '更新成功' : message === 'deleted' ? '删除成功' : message}
        </AdminAlert>
      )}

      <!-- Add Activity Form -->
      <AdminFormPage
        title="发布新活动"
        class="mb-6"
        id="activityForm"
        action="/api/admin/activities"
        enctype="multipart/form-data"
        formClass="space-y-4"
        wrapMain={false}
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">标识符 (Slug)</label>
              <input type="text" name="slug" required class="admin-input" placeholder="activity-slug" />
            </div>
            <div>
              <label class="admin-label">发布时间</label>
              <input type="datetime-local" name="published_at" class="admin-input" />
            </div>
            <div class="flex items-end gap-4">
              <label class="admin-checkbox-row">
                <input type="checkbox" name="is_featured" value="1" class="admin-checkbox" />
                <span class="admin-checkbox-label">推荐活动</span>
              </label>
              <label class="admin-checkbox-row">
                <input type="checkbox" name="is_active" value="1" checked class="admin-checkbox" />
                <span class="admin-checkbox-label">立即发布</span>
              </label>
            </div>
        </div>

        <div>
          <label class="admin-label">特色图片</label>
          <input type="file" name="featured_image" accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml" class="admin-input" />
          <p class="admin-help-text">显示在活动列表卡片和文章顶部；支持 JPG、PNG、GIF、WebP、SVG，最大 5MB。</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">标题 (中文)</label>
              <input type="text" name="title_zh" required class="admin-input" />
            </div>
            <div>
              <label class="admin-label">标题 (EN)</label>
              <input type="text" name="title_en" required class="admin-input" />
            </div>
            <div>
              <label class="admin-label">URL 标识 (中文)</label>
              <input type="text" name="slug_zh" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">URL 标识 (EN)</label>
              <input type="text" name="slug_en" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">简短描述 (中文)</label>
              <input type="text" name="description_zh" class="admin-input" placeholder="用于列表展示和SEO描述" />
            </div>
            <div>
              <label class="admin-label">简短描述 (EN)</label>
              <input type="text" name="description_en" class="admin-input" placeholder="Short description for lists and SEO" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">内容 (中文)</label>
              <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="请输入活动详细内容，支持标题、列表、引用、图片等格式">
                <input type="hidden" name="content_zh" data-rich-text-input value="" />
                <div class="tiptap-toolbar" data-rich-text-toolbar></div>
                <div data-rich-text-editor></div>
              </div>
              <p class="admin-help-text">支持标题、加粗、列表、引用、代码块、图片等格式。</p>
            </div>
            <div>
              <label class="admin-label">Content (EN)</label>
              <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="Enter detailed activity content with headings, lists, quotes, images, and more">
                <input type="hidden" name="content_en" data-rich-text-input value="" />
                <div class="tiptap-toolbar" data-rich-text-toolbar></div>
                <div data-rich-text-editor></div>
              </div>
              <p class="admin-help-text">Supports headings, emphasis, lists, quotes, code blocks, images, and more.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">SEO 标题 (中文)</label>
              <input type="text" name="meta_title_zh" class="admin-input" placeholder="留空使用活动标题" />
            </div>
            <div>
              <label class="admin-label">SEO Title (EN)</label>
              <input type="text" name="meta_title_en" class="admin-input" placeholder="Leave empty to use activity title" />
            </div>
            <div>
              <label class="admin-label">SEO 描述 (中文)</label>
              <input type="text" name="meta_desc_zh" class="admin-input" placeholder="留空使用简短描述" />
            </div>
            <div>
              <label class="admin-label">SEO Description (EN)</label>
              <input type="text" name="meta_desc_en" class="admin-input" placeholder="Leave empty to use short description" />
            </div>
        </div>

        <button type="submit" class="admin-btn admin-btn-primary">
          发布活动
        </button>
      </AdminFormPage>

      <!-- Activity List -->
      <AdminDataTable headClass="bg-gray-50 border-b border-gray-200" bodyClass="divide-y divide-gray-100">
        <Fragment slot="head">
          <tr>
            <th class="admin-table-head">ID</th>
            <th class="admin-table-head">标题</th>
            <th class="admin-table-head">发布时间</th>
            <th class="admin-table-head">状态</th>
            <th class="admin-table-head">浏览</th>
            <th class="admin-table-head">操作</th>
          </tr>
        </Fragment>

        {allActivities.length === 0 ? (
          <tr>
            <td colspan="6" class="admin-empty-state-table">
              暂无活动
            </td>
          </tr>
        ) : (
          allActivities.map((activity) => (
            <tr class="hover:bg-gray-50">
              <td class="admin-cell-muted">{activity.id}</td>
              <td class="admin-cell-strong">
                <div class="flex items-center gap-3">
                  {activity.featuredImageKey && (
                    <img
                      src={getActivityImageUrl(activity.featuredImageKey) || ''}
                      alt=""
                      class="h-12 w-20 shrink-0 rounded border border-gray-200 object-cover"
                    />
                  )}
                  <span>
                    {activity.titleZh || activity.slug}
                    {activity.isFeatured && <span class="ml-2 admin-text-accent">⭐</span>}
                  </span>
                </div>
              </td>
              <td class="admin-cell-muted">
                {new Date(activity.publishedAt).toLocaleDateString('zh-CN')}
              </td>
              <td class="admin-cell">
                <span class:list={[
                  'admin-badge',
                  activity.isActive ? 'admin-badge-success' : 'admin-badge-danger',
                ]}>
                  {activity.isActive ? '已发布' : '草稿'}
                </span>
              </td>
              <td class="admin-cell-muted">{activity.viewCount}</td>
              <td class="admin-cell">
                <div class="flex items-center gap-2">
                  <a href={`/admin/activities/edit/${activity.id}`} class="admin-action-link">
                    编辑
                  </a>
                  <form class="delete-form inline" method="POST" action={`/api/admin/activities?id=${activity.id}&_method=DELETE`}>
                    <button type="submit" class="admin-btn-danger">
                      删除
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        )}
      </AdminDataTable>
    </main>

    <script>
      // @ts-nocheck -- legacy DOM script; server and module code remain strictly checked.
      import { initAdminRichTextEditors } from '../../../scripts/admin-rich-text';
      initAdminRichTextEditors();

      // --- Activity Form ---
      document.getElementById('activityForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;

        submitBtn.textContent = '发布中...';
        submitBtn.disabled = true;

        try {
          const response = await fetch('/api/admin/activities', {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            // Success - redirect back to admin activities page
            window.location.href = '/admin/activities/?msg=created';
          } else {
            const error = await response.json();
            alert('发布失败: ' + (error.error || '未知错误'));
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }
        } catch (error) {
          console.error('发布活动时出错:', error);
          alert('发布活动时出错，请重试');
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });

      // Handle delete forms
      document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (!confirm('确定要删除这个活动吗？')) {
            return;
          }

          const formData = new FormData(form);
          const action = form.action;
          const deleteBtn = form.querySelector('button');
          const originalText = deleteBtn.textContent;

          deleteBtn.textContent = '删除中...';
          deleteBtn.disabled = true;

          try {
            const response = await fetch(action, {
              method: 'POST',
              body: formData
            });

            if (response.ok) {
              // Success - redirect back to admin activities page
              window.location.href = '/admin/activities/?msg=deleted';
            } else {
              const error = await response.json();
              alert('删除失败: ' + (error.error || '未知错误'));
              deleteBtn.textContent = originalText;
              deleteBtn.disabled = false;
            }
          } catch (error) {
            console.error('删除活动时出错:', error);
            alert('删除活动时出错，请重试');
            deleteBtn.textContent = originalText;
            deleteBtn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
