---
import '../../../styles/global.css';
import AdminHeader from '../../../components/AdminHeader.astro';
import AdminAlert from '../../../components/AdminAlert.astro';
import AdminHeaderActions from '../../../components/AdminHeaderActions.astro';
import AdminFormPage from '../../../components/AdminFormPage.astro';
import AdminSectionCard from '../../../components/AdminSectionCard.astro';
import AdminDataTable from '../../../components/AdminDataTable.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { activities, activitiesContent, activityCategories } from '../../../db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const lang: Locale = 'zh';
const db = getDb(env.DB);

// Check if tables exist first
let allActivities = [];
let categories = [];

try {
  // Try to get categories first
  categories = await db.select().from(activityCategories).orderBy(activityCategories.sort_order);

  // Get basic activity data
  const activityData = await db
    .select()
    .from(activities)
    .orderBy(desc(activities.published_at))
    .limit(50);

  // Get content and category info separately
  allActivities = await Promise.all(
    activityData.map(async (activity) => {
      try {
        const zhContent = await db
          .select()
          .from(activitiesContent)
          .where(and(eq(activitiesContent.activity_id, activity.id), eq(activitiesContent.lang, 'zh')))
          .limit(1)
          .then(rows => rows[0]);

        const category = await db
          .select()
          .from(activityCategories)
          .where(eq(activityCategories.id, activity.category_id))
          .limit(1)
          .then(rows => rows[0]);

        return {
          id: activity.id,
          slug: activity.slug,
          categoryId: activity.category_id,
          publishedAt: activity.published_at,
          isFeatured: activity.is_featured,
          isActive: activity.is_active,
          viewCount: activity.view_count,
          createdAt: activity.created_at,
          titleZh: zhContent?.title || '',
          categorySlug: category?.slug || '',
          categoryIcon: category?.icon || '',
        };
      } catch (err) {
        console.error('Error processing activity:', activity.id, err);
        return {
          id: activity.id,
          slug: activity.slug,
          categoryId: activity.category_id,
          publishedAt: activity.published_at,
          isFeatured: activity.is_featured,
          isActive: activity.is_active,
          viewCount: activity.view_count,
          createdAt: activity.created_at,
          titleZh: '',
          categorySlug: '',
          categoryIcon: '',
        };
      }
    })
  );
} catch (error) {
  console.error('Database query error:', error);
  // Set empty arrays if tables don't exist yet
  allActivities = [];
  categories = [];
}

const message = Astro.url.searchParams.get('msg');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>活动管理 - 管理后台</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title="活动管理"
      subtitle="发布、编辑与下线站点活动内容"
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard') },
        { href: '/admin/activities/', label: '活动管理', current: true },
        { href: '/admin/settings', label: t(lang, 'admin.userSettings') },
      ]}
    >
      <Fragment slot="actions">
        <AdminHeaderActions logoutLabel={t(lang, 'admin.logout')} />
      </Fragment>
    </AdminHeader>

    <main class="container mx-auto px-4 py-6">
      {message && (
        <AdminAlert>
          {message === 'created' ? '创建成功' : message === 'updated' ? '更新成功' : message === 'deleted' ? '删除成功' : message === 'category_created' ? '分类添加成功' : message === 'category_deleted' ? '分类删除成功' : message}
        </AdminAlert>
      )}

      <!-- Add Activity Form -->
      <AdminFormPage
        title="发布新活动"
        class="mb-6"
        id="activityForm"
        action="/api/admin/activities"
        enctype="multipart/form-data"
        formClass="space-y-4"
        wrapMain={false}
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">标识符 (Slug)</label>
              <input type="text" name="slug" required class="admin-input" placeholder="activity-slug" />
            </div>
            <div>
              <label class="admin-label">分类</label>
              <select name="category_id" required class="admin-input">
                <option value="">请选择分类</option>
                {categories.map((cat) => (
                  <option value={cat.id}>{cat.slug}</option>
                ))}
              </select>
              {categories.length === 0 && (
                <p class="admin-note-danger">暂无分类，请先创建活动分类</p>
              )}
            </div>
            <div>
              <label class="admin-label">发布时间</label>
              <input type="datetime-local" name="published_at" class="admin-input" />
            </div>
            <div class="flex items-end gap-4">
              <label class="admin-checkbox-row">
                <input type="checkbox" name="is_featured" value="1" class="admin-checkbox" />
                <span class="admin-checkbox-label">推荐活动</span>
              </label>
              <label class="admin-checkbox-row">
                <input type="checkbox" name="is_active" value="1" checked class="admin-checkbox" />
                <span class="admin-checkbox-label">立即发布</span>
              </label>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">标题 (中文)</label>
              <input type="text" name="title_zh" required class="admin-input" />
            </div>
            <div>
              <label class="admin-label">标题 (EN)</label>
              <input type="text" name="title_en" required class="admin-input" />
            </div>
            <div>
              <label class="admin-label">URL 标识 (中文)</label>
              <input type="text" name="slug_zh" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">URL 标识 (EN)</label>
              <input type="text" name="slug_en" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">简短描述 (中文)</label>
              <input type="text" name="description_zh" class="admin-input" placeholder="用于列表展示和SEO描述" />
            </div>
            <div>
              <label class="admin-label">简短描述 (EN)</label>
              <input type="text" name="description_en" class="admin-input" placeholder="Short description for lists and SEO" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">内容 (中文)</label>
              <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="请输入活动详细内容，支持标题、列表、引用、图片等格式">
                <input type="hidden" name="content_zh" data-rich-text-input value="" />
                <div class="tiptap-toolbar" data-rich-text-toolbar></div>
                <div data-rich-text-editor></div>
              </div>
              <p class="admin-help-text">支持标题、加粗、列表、引用、代码块、图片等格式。</p>
            </div>
            <div>
              <label class="admin-label">Content (EN)</label>
              <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="Enter detailed activity content with headings, lists, quotes, images, and more">
                <input type="hidden" name="content_en" data-rich-text-input value="" />
                <div class="tiptap-toolbar" data-rich-text-toolbar></div>
                <div data-rich-text-editor></div>
              </div>
              <p class="admin-help-text">Supports headings, emphasis, lists, quotes, code blocks, images, and more.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="admin-label">SEO 标题 (中文)</label>
              <input type="text" name="meta_title_zh" class="admin-input" placeholder="留空使用活动标题" />
            </div>
            <div>
              <label class="admin-label">SEO Title (EN)</label>
              <input type="text" name="meta_title_en" class="admin-input" placeholder="Leave empty to use activity title" />
            </div>
            <div>
              <label class="admin-label">SEO 描述 (中文)</label>
              <input type="text" name="meta_desc_zh" class="admin-input" placeholder="留空使用简短描述" />
            </div>
            <div>
              <label class="admin-label">SEO Description (EN)</label>
              <input type="text" name="meta_desc_en" class="admin-input" placeholder="Leave empty to use short description" />
            </div>
        </div>

        <button type="submit" class="admin-btn admin-btn-primary">
          发布活动
        </button>
      </AdminFormPage>

      <!-- Category Management -->
      <AdminSectionCard title="分类管理" class="mb-6">
        <!-- Add Category Form -->
        <form id="categoryForm" class="flex items-end gap-3 mb-4">
          <div class="flex-1 max-w-xs">
            <label class="admin-label">分类标识 (Slug)</label>
            <input type="text" id="categorySlug" required class="admin-input" placeholder="e.g. news, events" />
          </div>
          <div class="w-28">
            <label class="admin-label">排序</label>
            <input type="number" id="categorySort" class="admin-input" value="0" min="0" />
          </div>
          <button type="submit" class="admin-btn admin-btn-primary whitespace-nowrap">
            添加分类
          </button>
        </form>

        <!-- Category List -->
        <div id="categoryList">
          {categories.length === 0 ? (
            <p class="admin-empty-state">暂无分类</p>
          ) : (
            <div class="divide-y divide-gray-100">
              {categories.map((cat) => (
                <div class="flex items-center justify-between py-2" data-category-id={cat.id}>
                  <div class="flex items-center gap-3">
                    <span class="text-xs text-gray-400">#{cat.id}</span>
                    <span class="admin-text-strong">{cat.slug}</span>
                    <span class="admin-upload-subtext">排序: {cat.sort_order}</span>
                  </div>
                  <button
                    type="button"
                    class="category-delete-btn admin-btn-danger"
                    data-id={cat.id}
                    data-slug={cat.slug}
                  >
                    删除
                  </button>
                </div>
              ))}
            </div>
          )}
        </div>
      </AdminSectionCard>

      <!-- Activity List -->
      <AdminDataTable headClass="bg-gray-50 border-b border-gray-200" bodyClass="divide-y divide-gray-100">
        <Fragment slot="head">
          <tr>
            <th class="admin-table-head">ID</th>
            <th class="admin-table-head">标题</th>
            <th class="admin-table-head">分类</th>
            <th class="admin-table-head">发布时间</th>
            <th class="admin-table-head">状态</th>
            <th class="admin-table-head">浏览</th>
            <th class="admin-table-head">操作</th>
          </tr>
        </Fragment>

        {allActivities.length === 0 ? (
          <tr>
            <td colspan="7" class="admin-empty-state-table">
              暂无活动
            </td>
          </tr>
        ) : (
          allActivities.map((activity) => (
            <tr class="hover:bg-gray-50">
              <td class="admin-cell-muted">{activity.id}</td>
              <td class="admin-cell-strong">
                {activity.titleZh || activity.slug}
                {activity.isFeatured && <span class="ml-2 admin-text-accent">⭐</span>}
              </td>
              <td class="admin-cell">
                <span class="text-xs">
                  {activity.categorySlug}
                </span>
              </td>
              <td class="admin-cell-muted">
                {new Date(activity.publishedAt).toLocaleDateString('zh-CN')}
              </td>
              <td class="admin-cell">
                <span class:list={[
                  'admin-badge',
                  activity.isActive ? 'admin-badge-success' : 'admin-badge-danger',
                ]}>
                  {activity.isActive ? '已发布' : '草稿'}
                </span>
              </td>
              <td class="admin-cell-muted">{activity.viewCount}</td>
              <td class="admin-cell">
                <div class="flex items-center gap-2">
                  <a href={`/admin/activities/edit/${activity.id}`} class="admin-action-link">
                    编辑
                  </a>
                  <form class="delete-form inline" method="POST" action={`/api/admin/activities?id=${activity.id}&_method=DELETE`}>
                    <button type="submit" class="admin-btn-danger">
                      删除
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        )}
      </AdminDataTable>
    </main>

    <script>
      import { initAdminRichTextEditors } from '../../../scripts/admin-rich-text';
      initAdminRichTextEditors();

      // --- Category Management ---
      const categoryForm = document.getElementById('categoryForm') as HTMLFormElement;

      categoryForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const slugInput = document.getElementById('categorySlug') as HTMLInputElement;
        const sortInput = document.getElementById('categorySort') as HTMLInputElement;
        const submitBtn = categoryForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalText = submitBtn.textContent;

        const formData = new FormData();
        formData.append('slug', slugInput.value.trim());
        formData.append('sort_order', sortInput.value);

        submitBtn.textContent = '添加中...';
        submitBtn.disabled = true;

        try {
          const response = await fetch('/api/admin/activity-categories', {
            method: 'POST',
            body: formData,
          });

          if (response.ok) {
            window.location.href = '/admin/activities/?msg=category_created';
          } else {
            const error = await response.json();
            alert('添加失败: ' + (error.error || '未知错误'));
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }
        } catch (error) {
          console.error('添加分类时出错:', error);
          alert('添加分类时出错，请重试');
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });

      document.querySelectorAll('.category-delete-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const button = btn as HTMLButtonElement;
          const id = button.dataset.id;
          const slug = button.dataset.slug;

          if (!confirm(`确定要删除分类 "${slug}" 吗？`)) {
            return;
          }

          button.textContent = '删除中...';
          button.disabled = true;

          try {
            const response = await fetch(`/api/admin/activity-categories?id=${id}&_method=DELETE`, {
              method: 'POST',
            });

            if (response.ok) {
              window.location.href = '/admin/activities/?msg=category_deleted';
            } else {
              const error = await response.json();
              alert('删除失败: ' + (error.error || '未知错误'));
              button.textContent = '删除';
              button.disabled = false;
            }
          } catch (error) {
            console.error('删除分类时出错:', error);
            alert('删除分类时出错，请重试');
            button.textContent = '删除';
            button.disabled = false;
          }
        });
      });

      // --- Activity Form ---
      document.getElementById('activityForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;

        submitBtn.textContent = '发布中...';
        submitBtn.disabled = true;

        try {
          const response = await fetch('/api/admin/activities', {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            // Success - redirect back to admin activities page
            window.location.href = '/admin/activities/?msg=created';
          } else {
            const error = await response.json();
            alert('发布失败: ' + (error.error || '未知错误'));
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }
        } catch (error) {
          console.error('发布活动时出错:', error);
          alert('发布活动时出错，请重试');
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });

      // Handle delete forms
      document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (!confirm('确定要删除这个活动吗？')) {
            return;
          }

          const formData = new FormData(form);
          const action = form.action;
          const deleteBtn = form.querySelector('button');
          const originalText = deleteBtn.textContent;

          deleteBtn.textContent = '删除中...';
          deleteBtn.disabled = true;

          try {
            const response = await fetch(action, {
              method: 'POST',
              body: formData
            });

            if (response.ok) {
              // Success - redirect back to admin activities page
              window.location.href = '/admin/activities/?msg=deleted';
            } else {
              const error = await response.json();
              alert('删除失败: ' + (error.error || '未知错误'));
              deleteBtn.textContent = originalText;
              deleteBtn.disabled = false;
            }
          } catch (error) {
            console.error('删除活动时出错:', error);
            alert('删除活动时出错，请重试');
            deleteBtn.textContent = originalText;
            deleteBtn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
