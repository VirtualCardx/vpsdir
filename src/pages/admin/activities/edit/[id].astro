---
import '../../../../styles/global.css';
import AdminHeader from '../../../../components/AdminHeader.astro';
import AdminHeaderActions from '../../../../components/AdminHeaderActions.astro';
import AdminFormPage from '../../../../components/AdminFormPage.astro';
import { t } from '../../../../i18n/utils';
import type { Locale } from '../../../../i18n/config';
import { getDb } from '../../../../lib/db';
import { activities, activitiesContent, activityCategories } from '../../../../db/schema';
import { eq, and } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const lang: Locale = 'zh';
const db = getDb(env.DB);

const id = Number(Astro.params.id);
if (isNaN(id)) return Astro.redirect('/admin/activities/');

const activity = await db.select().from(activities).where(eq(activities.id, id)).get();
if (!activity) return Astro.redirect('/admin/activities/');

const contentZh = await db
  .select()
  .from(activitiesContent)
  .where(and(eq(activitiesContent.activity_id, id), eq(activitiesContent.lang, 'zh')))
  .get();

const contentEn = await db
  .select()
  .from(activitiesContent)
  .where(and(eq(activitiesContent.activity_id, id), eq(activitiesContent.lang, 'en')))
  .get();

const categories = await db.select().from(activityCategories).orderBy(activityCategories.sort_order);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>编辑活动 - {contentZh?.title || activity.slug}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title="编辑活动"
      subtitle={contentZh?.title || activity.slug}
      backHref="/admin/activities/"
      backLabel="返回活动列表"
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard') },
        { href: '/admin/activities/', label: '活动管理', current: true },
        { href: '/admin/settings', label: t(lang, 'admin.userSettings') },
      ]}
    >
      <Fragment slot="actions">
        <AdminHeaderActions logoutLabel={t(lang, 'admin.logout')} />
      </Fragment>
    </AdminHeader>

    <AdminFormPage
      id="activityForm"
      action={`/api/admin/activities?id=${id}&_method=PUT`}
      enctype="multipart/form-data"
      formClass="space-y-4"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">标识符 (Slug)</label>
            <input type="text" name="slug" required value={activity.slug} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">分类</label>
            <select name="category_id" required class="admin-input">
              {categories.map((cat) => (
                <option value={cat.id} selected={cat.id === activity.categoryId}>
                  {cat.slug}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label class="admin-label">发布时间</label>
            <input type="datetime-local" name="published_at" value={activity.publishedAt.slice(0, 16)} class="admin-input" />
          </div>
          <div class="flex items-end gap-4">
            <label class="admin-checkbox-row">
              <input type="checkbox" name="is_featured" value="1" checked={activity.isFeatured} class="admin-checkbox" />
              <span class="admin-checkbox-label">推荐活动</span>
            </label>
            <label class="admin-checkbox-row">
              <input type="checkbox" name="is_active" value="1" checked={activity.isActive} class="admin-checkbox" />
              <span class="admin-checkbox-label">已发布</span>
            </label>
          </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">标题 (中文)</label>
            <input type="text" name="title_zh" required value={contentZh?.title || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">标题 (EN)</label>
            <input type="text" name="title_en" required value={contentEn?.title || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">URL 标识 (中文)</label>
            <input type="text" name="slug_zh" value={contentZh?.slug || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">URL 标识 (EN)</label>
            <input type="text" name="slug_en" value={contentEn?.slug || ''} class="admin-input" />
          </div>
          <div>
            <label class="admin-label">简短描述 (中文)</label>
            <input type="text" name="description_zh" value={contentZh?.description || ''} class="admin-input" placeholder="用于列表展示和SEO描述" />
          </div>
          <div>
            <label class="admin-label">简短描述 (EN)</label>
            <input type="text" name="description_en" value={contentEn?.description || ''} class="admin-input" placeholder="Short description for lists and SEO" />
          </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">内容 (中文)</label>
            <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="请输入活动详细内容，支持标题、列表、引用、图片等格式">
              <input type="hidden" name="content_zh" data-rich-text-input value={contentZh?.content || ''} />
              <div class="tiptap-toolbar" data-rich-text-toolbar></div>
              <div data-rich-text-editor></div>
            </div>
            <p class="admin-help-text">支持标题、加粗、列表、引用、代码块、图片等格式。</p>
          </div>
          <div>
            <label class="admin-label">Content (EN)</label>
            <div class="tiptap-editor-shell" data-rich-text-root data-placeholder="Enter detailed activity content with headings, lists, quotes, images, and more">
              <input type="hidden" name="content_en" data-rich-text-input value={contentEn?.content || ''} />
              <div class="tiptap-toolbar" data-rich-text-toolbar></div>
              <div data-rich-text-editor></div>
            </div>
            <p class="admin-help-text">Supports headings, emphasis, lists, quotes, code blocks, images, and more.</p>
          </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="admin-label">SEO 标题 (中文)</label>
            <input type="text" name="meta_title_zh" value={contentZh?.metaTitle || ''} class="admin-input" placeholder="留空使用活动标题" />
          </div>
          <div>
            <label class="admin-label">SEO Title (EN)</label>
            <input type="text" name="meta_title_en" value={contentEn?.metaTitle || ''} class="admin-input" placeholder="Leave empty to use activity title" />
          </div>
          <div>
            <label class="admin-label">SEO 描述 (中文)</label>
            <input type="text" name="meta_desc_zh" value={contentZh?.metaDesc || ''} class="admin-input" placeholder="留空使用简短描述" />
          </div>
          <div>
            <label class="admin-label">SEO Description (EN)</label>
            <input type="text" name="meta_desc_en" value={contentEn?.metaDesc || ''} class="admin-input" placeholder="Leave empty to use short description" />
          </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="admin-btn admin-btn-primary">
          保存更改
        </button>
        <a
          href="/admin/activities/"
          class="admin-btn admin-btn-secondary"
        >
          取消
        </a>
      </div>
    </AdminFormPage>

    <script>
      import { initAdminRichTextEditors } from '../../../../scripts/admin-rich-text';
      initAdminRichTextEditors();

      // Handle form submission with redirect
      document.getElementById('activityForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;

        submitBtn.textContent = '更新中...';
        submitBtn.disabled = true;

        try {
          const response = await fetch(`/api/admin/activities?id=${id}&_method=PUT`, {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            // Success - redirect back to admin activities page
            window.location.href = '/admin/activities/?msg=updated';
          } else {
            const error = await response.json();
            alert('更新失败: ' + (error.error || '未知错误'));
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }
        } catch (error) {
          console.error('更新活动时出错:', error);
          alert('更新活动时出错，请重试');
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>
