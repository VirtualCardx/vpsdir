---
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
import AdminAlert from '../../components/AdminAlert.astro';
import AdminHeaderActions from '../../components/AdminHeaderActions.astro';
import AdminFormPage from '../../components/AdminFormPage.astro';
import { users } from '../../db/schema';
import { getDb } from '../../lib/db';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const lang: Locale = 'zh';
const db = getDb(env.DB);
const message = Astro.url.searchParams.get('msg');
const error = Astro.url.searchParams.get('error');
const userId = Astro.locals.userId;

if (!userId) {
  return Astro.redirect('/admin/login');
}

const currentUser = await db.select().from(users).where(eq(users.id, userId)).get();
if (!currentUser) {
  return Astro.redirect('/admin/login');
}

const errorMessageMap: Record<string, string> = {
  missing: '请完整填写密码信息。',
  too_short: '新密码至少需要 8 位。',
  mismatch: '两次输入的新密码不一致。',
  invalid_current: '当前密码不正确。',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'admin.userSettings')}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminHeader
      title={t(lang, 'admin.userSettings')}
      subtitle={`当前用户：${currentUser.username}`}
      navItems={[
        { href: '/admin/', label: t(lang, 'admin.dashboard') },
        { href: '/admin/activities/', label: '活动管理' },
        { href: '/admin/settings', label: t(lang, 'admin.userSettings'), current: true },
      ]}
    >
      <Fragment slot="actions">
        <AdminHeaderActions logoutLabel={t(lang, 'admin.logout')} />
      </Fragment>
    </AdminHeader>

    <AdminFormPage
      title={t(lang, 'admin.userSettings')}
      description={t(lang, 'admin.passwordRequirements')}
      class="max-w-2xl"
      action="/api/auth/password"
    >
      <Fragment slot="before">
        {message === 'password_updated' && (
          <AdminAlert>
            {t(lang, 'admin.passwordUpdated')}
          </AdminAlert>
        )}

        {error && (
          <AdminAlert variant="error">
            {errorMessageMap[error] || '更新密码失败，请重试。'}
          </AdminAlert>
        )}
      </Fragment>

      <div>
        <label for="currentPassword" class="admin-label">
          {t(lang, 'admin.currentPassword')}
        </label>
        <input
          id="currentPassword"
          name="currentPassword"
          type="password"
          required
          autocomplete="current-password"
          class="admin-input"
        />
      </div>

      <div>
        <label for="newPassword" class="admin-label">
          {t(lang, 'admin.newPassword')}
        </label>
        <input
          id="newPassword"
          name="newPassword"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="admin-input"
        />
      </div>

      <div>
        <label for="confirmPassword" class="admin-label">
          {t(lang, 'admin.confirmPassword')}
        </label>
        <input
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="admin-input"
        />
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="admin-btn admin-btn-primary font-medium"
        >
          {t(lang, 'admin.updatePassword')}
        </button>
      </div>
    </AdminFormPage>
  </body>
</html>
