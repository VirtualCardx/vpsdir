---
import '../../styles/global.css';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

const lang: Locale = 'zh';
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'admin.login')}</title>
  </head>
  <body class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-sm mx-auto p-6">
      <section class="bg-white rounded-lg border border-gray-200 p-6">
        <h1 class="text-2xl font-bold text-center text-gray-900 mb-8">{t(lang, 'admin.login')}</h1>

        {error && (
          <div class="admin-alert admin-alert-error">
            {error === 'invalid' ? '用户名或密码错误' : '登录失败'}
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="space-y-4">
          <div>
            <label for="username" class="admin-label">
              {t(lang, 'admin.username')}
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              autocomplete="username"
              class="admin-input"
            />
          </div>

          <div>
            <label for="password" class="admin-label">
              {t(lang, 'admin.password')}
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="admin-input"
            />
          </div>

          <button
            type="submit"
            class="admin-btn admin-btn-primary w-full font-medium"
          >
            {t(lang, 'admin.submit')}
          </button>
        </form>
      </section>
    </div>
  </body>
</html>
