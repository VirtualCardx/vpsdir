---
import '../../styles/global.css';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

const lang: Locale = 'zh';
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'admin.login')}</title>
  </head>
  <body class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-sm mx-auto p-6">
      <h1 class="text-2xl font-bold text-center text-gray-900 mb-8">{t(lang, 'admin.login')}</h1>

      {error && (
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm">
          {error === 'invalid' ? '用户名或密码错误' : '登录失败'}
        </div>
      )}

      <form method="POST" action="/api/auth/login" class="space-y-4">
        <div>
          <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
            {t(lang, 'admin.username')}
          </label>
          <input
            type="text"
            id="username"
            name="username"
            required
            autocomplete="username"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
            {t(lang, 'admin.password')}
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-gray-900 text-white py-2.5 rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium"
        >
          {t(lang, 'admin.submit')}
        </button>
      </form>
    </div>
  </body>
</html>
